---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import resources from '../data/resources.json';
const groups=['Official authorities','Registers & archives','Scholarly & educational'];
const readings=[
{title:"The distinction between picture and grant",location:"College of Arms",url:"https://www.college-of-arms.gov.uk/About/11.htm",note:"The College explains how a blazon, rather than a particular artistic rendering, can define granted arms."},
{title:"What actually descends?",location:"College of Arms",url:"https://www.college-of-arms.gov.uk/resources/the-law-of-arms",note:"Official English guidance on inheritance, heraldic heiresses and cadency."},
{title:"Why Scotland is different",location:"Court of the Lord Lyon",url:"https://www.courtofthelordlyon.scot/coats%20of%20arms.htm",note:"Grants and matriculations in the Scottish recording tradition."},
{title:"Canadian records and reproduction",location:"Governor General of Canada",url:"https://gg.ca/en/heraldry/public-register",note:"An official research register. Its imagery has restrictions; follow the institution's reproduction conditions."}
];
---
<Base title="Sources & Research" description="An annotated bibliography of the College of Arms, the Court of the Lord Lyon, the Canadian Heraldic Authority, teaching societies and archival resources.">
  <PageIntro eyebrow="The reading room" title="Follow the evidence." description="A catalogue can help you locate an object; a grant can record an armorial act. Start by asking what you need to establish, then follow the source capable of supporting that claim."/>
  <section class="section">
    <div class="wrap">
      <div class="notice-box" style="margin-bottom:55px"><strong>An editorial principle.</strong><p>Official heraldic authorities are primary sources for their own jurisdictions. Educational societies, books and digital archives are invaluable, but their statements and holdings are not interchangeable with a grant or official register entry.</p></div>
      {groups.map(group=><section class="resource-group"><p class="eyebrow"><span class="star">✦</span> Annotated directory</p><h2>{group}</h2><div class="resource-list">{resources.filter(item=>item.group===group).map(item=><article class="resource-card"><div class="smallcaps" style="color:var(--red)">{item.type} · {item.jurisdiction}</div><h3>{item.title}</h3><p>{item.description}</p><a href={item.url} target="_blank" rel="noopener noreferrer">Visit source ↗</a></article>)}</div></section>)}
    </div>
  </section>
  <section class="section section-toned">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> Four places worth bookmarking</p><h2 class="section-title">Start with<br/>the originals.</h2></div><p>These sources explain how a design is described, inherited, or recorded in their respective systems. Follow the actual terms before applying the explanation to a particular bearer.</p></div>
      <div class="resource-list">
        {readings.map(item=><article class="field-panel"><span class="smallcaps" style="color:var(--red)">{item.location}</span><h3 style="margin-top:14px">{item.title}</h3><p>{item.note}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">Read the source ↗</a></article>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap split" style="align-items:center">
      <div><p class="eyebrow"><span class="star">✦</span> Reading intelligently</p><h2 class="section-title">A research<br/>checklist.</h2><p class="section-subtitle" style="margin-top:17px">Before concluding that a shield belonged to a particular ancestor, make sure you can answer the questions that connect image, document, and bearer.</p></div>
      <div class="field-panel"><ol style="margin:0;padding-left:20px;display:grid;gap:15px;font-size:.91rem"><li>Who is actually named as the armiger in the original record?</li><li>Which authority or archival collection preserved the record?</li><li>What is the earliest datable evidence of the arms?</li><li>Is the blazon known, or only a later artistic rendering?</li><li>If claiming descent, where is the documented chain?</li><li>Which jurisdiction's practice would govern the claim?</li></ol></div>
    </div>
  </section>
</Base>
