---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import sources from '../../data/world-sources.json';
import readings from '../../data/parallel-readings.json';
const sorted=[...sources].sort((a,b)=>a.area.localeCompare(b.area)||a.titleOriginal.localeCompare(b.titleOriginal));
const regions=[...new Set(sorted.map(s=>s.area))].sort();
const languageLabels:Record<string,string>={fr:'French',de:'German',nl:'Dutch',sv:'Swedish',es:'Spanish',pt:'Portuguese',it:'Italian',pl:'Polish',cs:'Czech',ja:'Japanese',en:'English',lv:'Latvian',lt:'Lithuanian',fi:'Finnish',ro:'Romanian',hr:'Croatian',hu:'Hungarian',sl:'Slovenian',ru:'Russian',tr:'Turkish',la:'Latin',da:'Danish',el:'Greek',uk:'Ukrainian',nb:'Norwegian (Bokmål)',is:'Icelandic',et:'Estonian',sk:'Slovak',bg:'Bulgarian',sq:'Albanian'};
const languages=[...new Set(sorted.map(s=>s.language))].sort((a,b)=>(languageLabels[a]||a).localeCompare(languageLabels[b]||b,'en'));
---
<Base title="International Source Atlas" description="A searchable, source-provenanced atlas of heraldic archives, registers, legal records and specialist institutions in more than a dozen source languages, with original English synopses and bilingual terminology.">
  <PageIntro eyebrow="Read the world in its own words" title="The source atlas." description="Original-language documents, archival guides, statutes and research literature from around the world. Every entry links to its source, gives an English analysis, and preserves vocabulary you would otherwise have to guess."/>
  <section class="section">
    <div class="wrap">
      <div class="notice-box"><strong>What each source note provides.</strong><p>A catalogue can help you find an object; a statute can record a legal decision. The source notes explain which kind of evidence each document supplies and preserve its original title, language, institution, and link. Our English synopses summarize that evidence. Reproducing a complete text or translation requires its own verified rights.</p></div>
      <div class="atlas-export-bar">
        <div><strong>Keep the references with your work.</strong><p>Download all references, or copy a single source directly from its dossier. Access dates are cited without inventing publication years.</p></div>
        <div class="atlas-export-links">
          <a href="/source-atlas/library.bib" class="btn btn-dark" download>Download BibTeX ↓</a>
          <a href="/source-atlas/library.ris" class="btn btn-line" download>RIS ↓</a>
          <a href="/source-atlas/library.json" class="btn btn-line" download>CSL JSON ↓</a>
        </div>
      </div>
      <p id="citation-feedback" role="status" aria-live="polite" class="caption"></p>
      <div class="atlas-tools">
        <label for="atlas-search"><span class="smallcaps">Search documents, terms and commentary</span><input id="atlas-search" type="search" placeholder="Try ‘Wappenrolle’, ‘1696’, ‘municipal’, ‘家紋’…" autocomplete="off"/></label>
        <label for="atlas-language"><span class="smallcaps">Source language</span><select id="atlas-language"><option value="">All languages</option>{languages.map(lang=><option value={lang}>{languageLabels[lang]||lang}</option>)}</select></label>
        <label for="atlas-region"><span class="smallcaps">Tradition / region</span><select id="atlas-region"><option value="">All regions</option>{regions.map(region=><option value={region}>{region}</option>)}</select></label>
      </div>
      <p class="caption" style="margin:0 0 15px">Want to read verified original-language excerpts beside English? <a href="/translation-lab/" style="color:var(--red);text-decoration:underline">Visit the parallel translation laboratory ↗</a></p>
      <p class="caption">For folio-level work, try the <a href="/transcription-desk/" class="text-link">manuscript transcription desk ↗</a> and its French and Portuguese witness dossiers.</p>
      <div class="atlas-resultbar"><p id="atlas-results" role="status" aria-live="polite">{sources.length} source dossiers</p><button id="atlas-reset" class="chip" type="button">Clear filters ↺</button></div>
      <div class="atlas-grid">
        {sorted.map(source=><article class="atlas-card" id={'source-'+source.id} data-lang={source.language} data-region={source.area} data-text={(source.titleOriginal+' '+source.titleEnglish+' '+source.holding+' '+source.englishSynopsis+' '+source.glossary.map(t=>t.term+' '+t.english).join(' ')).toLowerCase()}>
          <div class="atlas-top"><span class="atlas-language">{source.language.toUpperCase()}</span><span class="smallcaps">{source.area}</span></div>
          <h2 lang={source.language}>{source.titleOriginal}</h2><p class="atlas-translation">{source.titleEnglish}</p>
          <p class="atlas-holding">{source.holding} · {source.kind}</p>
          <div class="atlas-summary"><h3>English editorial synopsis</h3><p>{source.englishSynopsis}</p></div>
          <div class="atlas-glossary"><h3>Source-language vocabulary</h3><dl>{source.glossary.map(t=><div><dt lang={source.language}>{t.term}</dt><dd>{t.english}</dd></div>)}</dl></div>
          <p class="atlas-provenance"><strong>Evidence class:</strong> {source.authority}. <strong>Rights:</strong> metadata and original synopsis only. <strong>Review:</strong> editorial research note, specialist review pending.</p>
          <div class="citation-buttons" aria-label={'Citation formats for '+source.titleOriginal}><button class="chip" type="button" data-copy-source={source.id} data-citation-format="bibtex">Copy BibTeX</button><button class="chip" type="button" data-copy-source={source.id} data-citation-format="ris">Copy RIS</button><button class="chip" type="button" data-copy-source={source.id} data-citation-format="csl">Copy CSL JSON</button></div>
          <div style="display:grid;gap:9px"><a href={source.url} class="btn btn-dark" target="_blank" rel="noopener noreferrer">Read original source ↗</a>{readings.some(r=>r.sourceId===source.id)&&<a href={'/translation-lab/#translation-'+readings.find(r=>r.sourceId===source.id)?.id} class="btn btn-line">Try a short parallel translation ↗</a>}</div>
        </article>)}
        <p class="empty-state" id="atlas-empty" hidden>No matching documents. Clear a filter or try a broader term.</p>
      </div>
      <p class="caption" style="margin-top:32px">Source survey begun 8 October 2026. Records reflect source availability at research time, not perpetual validation of linked content. Historical rights and image copyright must be assessed separately.</p>
    </div>
  </section>
  <script>
    import sources from '../../data/world-sources.json';
    import {makeBibtex,makeRIS,makeCSL} from '../../lib/bibliography.js';
    const citations=new Map(sources.map(item=>[item.id,item]));
    const citationFeedback=document.querySelector<HTMLElement>('#citation-feedback');
    document.querySelectorAll<HTMLButtonElement>('[data-copy-source]').forEach(button=>button.addEventListener('click',async()=>{
      const source=citations.get(button.dataset.copySource||'');
      if(!source)return;
      const format=button.dataset.citationFormat||'bibtex';
      const citation=format==='ris'?makeRIS(source):format==='csl'?JSON.stringify(makeCSL(source),null,2):makeBibtex(source);
      try{
        await navigator.clipboard.writeText(citation);
        if(citationFeedback)citationFeedback.textContent='Copied '+format.toUpperCase()+' for '+source.titleOriginal+'.';
      }catch{
        if(citationFeedback)citationFeedback.textContent='Clipboard not available in this browser. Use the full bibliography download above.';
      }
    }));
    const search=document.querySelector<HTMLInputElement>('#atlas-search');
    const language=document.querySelector<HTMLSelectElement>('#atlas-language');
    const region=document.querySelector<HTMLSelectElement>('#atlas-region');
    const entries=document.querySelectorAll<HTMLElement>('.atlas-card');
    const status=document.querySelector<HTMLElement>('#atlas-results');
    const empty=document.querySelector<HTMLElement>('#atlas-empty');
    const apply=()=>{
      const q=(search?.value||'').trim().toLowerCase();
      const l=language?.value||'';
      const r=region?.value||'';
      let found=0;
      entries.forEach(entry=>{
        const visible=(!l||entry.dataset.lang===l)&&(!r||entry.dataset.region===r)&&(!q||entry.dataset.text?.includes(q));
        entry.hidden=!visible;
        if(visible)found++;
      });
      if(status)status.textContent=found+' source dossier'+(found===1?'':'s');
      if(empty)empty.hidden=found!==0;
      const params=new URLSearchParams();if(q)params.set('q',q);if(l)params.set('lang',l);if(r)params.set('region',r);
      history.replaceState(null,'',location.pathname+(params.toString()?'?'+params.toString():'')+location.hash);
    };
    const params=new URLSearchParams(location.search);
    if(search)search.value=params.get('q')||'';
    if(language)language.value=params.get('lang')||'';
    if(region)region.value=params.get('region')||'';
    [search,language,region].forEach(element=>element?.addEventListener('input',apply));
    document.querySelector('#atlas-reset')?.addEventListener('click',()=>{
      if(search)search.value='';if(language)language.value='';if(region)region.value='';
      apply();search?.focus();
    });
    apply();
  </script>
  <style>
    .atlas-export-bar{display:flex;justify-content:space-between;align-items:center;gap:25px;flex-wrap:wrap;background:#e6ddce;padding:23px;margin-top:27px;border:1px solid var(--line)}
    .atlas-export-bar strong{font:500 1.55rem var(--serif);display:block;margin:0 0 5px}
    .atlas-export-bar p{color:var(--ink-2);font-size:.79rem;margin:0;max-width:520px}
    .atlas-export-links{display:flex;gap:8px;flex-wrap:wrap}
    .atlas-export-links .btn{min-height:44px;padding:.8rem}
    .citation-buttons{display:flex;gap:7px;flex-wrap:wrap;margin:-10px 0 19px}
    .citation-buttons .chip{font-size:.65rem;padding:.44rem .63rem}
  </style>
</Base>
