---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import {objectStudies,objectCitation} from '../../lib/objects.js';
import {makeBibtex} from '../../lib/bibliography.js';
export function getStaticPaths(){return objectStudies.map(object=>({params:{slug:object.id},props:{object}}));}
const {object}=Astro.props;
const citation=makeBibtex(objectCitation(object));
const others=objectStudies.filter(other=>other.id!==object.id);
---
<Base title={object.title+' — Object Study'} description={object.summary}>
  <PageIntro eyebrow={object.culture+' · '+object.date} title={object.title} description={object.summary}/>
  <section class="section">
    <div class="wrap">
      <a href="/objects/" class="text-link">← All historical object studies</a>
      <div class="object-layout">
        <figure class="object-figure">
          <a href={object.image} target="_blank" rel="noopener" aria-label={'Enlarge photograph of '+object.catalogueTitle}><img src={object.image} alt={object.alt} width={object.width} height={object.height} fetchpriority="high"/></a>
          <figcaption>{object.catalogueTitle}. {object.museum}, {object.accession}. {object.credit}. <a href={object.imageSource}>Museum source photograph ↗</a> · <a href={object.rightsUrl}>Open Access (CC0)</a>. Web image resized without cropping or recolouring.</figcaption>
          <a class="btn btn-line" href={object.image} target="_blank" rel="noopener">Enlarge the photograph ↗</a>
        </figure>
        <aside class="object-record" aria-label="Museum object record">
          <p class="eyebrow"><span class="star">✦</span> The documentary address</p><h2>{object.catalogueTitle}</h2>
          <dl>{[['Institution',object.museum],['Accession',object.accession],['Catalogue date',object.date],['Catalogue culture',object.culture],['Medium',object.medium],['Credit line',object.credit],['Record consulted',object.accessed]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
          <a href={object.url} class="btn btn-dark">Read the museum record ↗</a>
          <p class="caption">Catalogue-based teaching study; specialist review pending. This is not a new authentication, grant, or bearer identification.</p>
        </aside>
      </div>
      <div class="object-reading">
        <nav class="study-nav" aria-label="In this study"><a href="#look">Look</a><a href="#record">Read the record</a><a href="#interpret">Interpret</a><a href="#evidence">Check the evidence</a><a href="#workshop">Try the workshop</a><a href="#sources">Cite the source</a></nav>
        <section id="look"><p class="eyebrow"><span class="star">✦</span> Photograph-based observations</p><h2>{object.question}</h2>{object.observations.map(paragraph=><p>{paragraph}</p>)}</section>
        <section id="record"><h2>What the catalogue tells us</h2><p>{object.catalogue.replace(/\s*\[1\]$/, '')} <a href="#source-1" aria-label="Museum source note 1"><sup>[1]</sup></a></p></section>
        <section id="interpret"><p class="eyebrow"><span class="star">✦</span> Editorial interpretation</p><h2>Read the arrangement. Keep the uncertainty.</h2>{object.reading.map(paragraph=><p>{paragraph}</p>)}</section>
        <section id="evidence"><h2>A small claim ledger</h2><div class="table-scroll" tabindex="0" role="region" aria-label="Claims, evidence and limits"><table><thead><tr><th scope="col">Claim</th><th scope="col">Evidence</th><th scope="col">Limit</th></tr></thead><tbody>{object.claims.map(row=><tr><th scope="row">{row.claim}</th><td>{row.basis}</td><td>{row.limit}</td></tr>)}</tbody></table></div></section>
        <section id="workshop" class="object-workshop"><p class="eyebrow"><span class="star">✦</span> Your turn</p><h2>Make an argument someone can check.</h2><p>{object.exercise}</p><details><summary>Discuss your answer</summary><p>{object.discussion}</p></details><h3>Take the research further</h3><p>{object.research}</p><a href={'/academy/'+object.lesson+'/'} class="text-link">Return to the related Academy reading ↗</a></section>
        <section id="sources"><h2>Sources and image rights</h2><ol><li id="source-1"><a href={object.url}>{object.museum}, <em>{object.catalogueTitle}</em>, accession {object.accession}</a>. Collection record consulted {object.accessed}. The object date above is the catalogue’s dating of the artifact, not the date of this webpage.</li><li><a href={object.rightsUrl}>The Met Open Access policy</a>. The individual record labels the reproduced image Public Domain; the Open Access policy releases qualifying images and basic data under CC0. Image credit: {object.credit}. The museum catalogue’s prose is summarized, not reproduced in full.</li></ol>
          <details class="citation"><summary>Show the BibTeX citation</summary><pre id="object-bibtex">{citation}</pre></details><button class="chip" id="copy-object-citation" type="button">Copy BibTeX</button><p id="citation-status" class="caption" role="status" aria-live="polite"></p>
        </section>
        <div class="other-studies"><h2>Keep looking</h2>{others.map(other=><a class="text-link" href={'/objects/'+other.id+'/'}>{other.title} ↗</a>)}</div>
      </div>
    </div>
  </section>
  <script>
    document.querySelector('#copy-object-citation')?.addEventListener('click',async()=>{
      const text=document.querySelector('#object-bibtex')?.textContent||'';
      const status=document.querySelector('#citation-status');
      try{await navigator.clipboard.writeText(text);if(status)status.textContent='Museum record citation copied.';}
      catch{const details=document.querySelector<HTMLDetailsElement>('.citation');if(details)details.open=true;if(status)status.textContent='Select the visible citation to copy it.';}
    });
  </script>
  <style>
    .object-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(24px,4vw,55px);align-items:start;margin:30px 0 55px}
    .object-figure{margin:0;min-width:0}.object-figure>a:first-child{display:flex;align-items:center;justify-content:center;background:var(--paper-2);padding:clamp(12px,3vw,30px);border:1px solid var(--line)}
    .object-figure img{display:block;width:auto;height:auto;max-height:650px;object-fit:contain}.object-figure figcaption{font-size:.74rem;color:var(--ink-2);margin:15px 0}.object-figure figcaption a{text-decoration:underline}
    .object-record{min-width:0}.object-record h2{font:500 2rem/1.1 var(--serif)}.object-record dl{margin:24px 0}.object-record dl div{border-bottom:1px solid var(--line);padding:10px 0}.object-record dt{font-size:.65rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}.object-record dd{margin:3px 0;font-size:.88rem}.object-record .caption{margin-top:20px}
    .object-reading{max-width:850px;margin:auto}.object-reading section{margin:48px 0}.object-reading h2,.other-studies h2{font:500 clamp(1.8rem,4vw,2.7rem)/1.12 var(--serif)}.object-reading h3{font:500 1.6rem var(--serif);margin-top:28px}.object-reading p{line-height:1.85}.object-reading a{text-decoration:underline;text-underline-offset:3px}
    .study-nav{display:flex;gap:12px 24px;flex-wrap:wrap;border-block:1px solid var(--line);padding:20px 0;font-size:.8rem}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:550px;font-size:.82rem}th,td{padding:15px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
    .object-workshop{background:var(--paper-2);padding:clamp(18px,4vw,35px);border:1px solid var(--line)}details{border:1px solid var(--line);padding:16px;margin:20px 0}summary{cursor:pointer;font-weight:650}details p{margin:15px 0 0}.citation pre{overflow-x:auto;font-size:.75rem;white-space:pre-wrap;overflow-wrap:anywhere}.other-studies{border-top:1px solid var(--line);padding-top:30px;display:grid;gap:15px}
    @media(max-width:800px){.object-layout{grid-template-columns:1fr}.object-figure img{max-height:520px}}
  </style>
</Base>
