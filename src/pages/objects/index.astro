---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import {objectStudies} from '../../lib/objects.js';
import ObjectCredit from '../../components/ObjectCredit.astro';
import {searchableObjectText} from '../../lib/object-filters.js';
import ObjectImage from '../../components/ObjectImage.astro';
const materials=[...new Set(objectStudies.map(object=>object.material))];
---
<Base title="Object Studies" description="Investigate heraldry across armour, banners, glass, coins, textiles, manuscripts, and modern chapel displays, with licensed photographs and source-linked research exercises.">
  <PageIntro eyebrow="Heraldry in the material world" title="Arms you can investigate." description={objectStudies.length+' objects and displays, from medieval textiles to modern chapel banners. Ask what an image tells us—and what it leaves unresolved.'}/>
  <section class="section">
    <div class="wrap">
      <div class="notice-box"><strong>Begin with the object.</strong><p>These studies reproduce licensed museum and archival photographs, including dated views of modern displays. Dates, identifications, and attributions come from the linked source records; our visual observations and research questions are editorial teaching notes. Specialist review remains pending.</p></div>
      <div class="lexicon-top" style="margin-top:35px"><div><p class="eyebrow"><span class="star">✦</span> Explore the collection</p><h2 class="small-title">A photograph is a beginning.</h2></div><span id="object-count" class="smallcaps" role="status">{objectStudies.length} studies shown</span></div>
      <form class="object-filters" id="object-filters" role="search" aria-label="Find object studies">
        <label>Search the collection<input type="search" id="object-query" placeholder="Try banners, Medici, or Zürich"/></label>
        <label>Material<select id="object-material"><option value="">All materials</option>{materials.map(material=><option>{material}</option>)}</select></label>
        <label>Period<select id="object-period"><option value="">All periods</option>{['Medieval','Early modern','Modern'].map(period=><option>{period}</option>)}</select></label>
        <button class="btn btn-line" type="reset">Clear filters</button>
      </form>
      <p class="caption">Periods overlap for broadly dated objects. “Modern” includes dated photographs of longstanding institutions.</p>
      <p id="object-empty" hidden role="status">No studies match these filters. Try a broader search or clear the filters.</p>
      <div class="object-grid">
        {objectStudies.map(object=><article class="object-card" data-object data-material={object.material} data-periods={JSON.stringify(object.periods)} data-search={searchableObjectText(object)}>
          <a class="object-plinth" href={'/objects/'+object.id+'/'} aria-label={'Study '+object.catalogueTitle}><ObjectImage object={object}/></a>
          <div class="object-body"><ObjectCredit object={object}/><span class="smallcaps">{object.culture} · {object.date}</span><h2><a href={'/objects/'+object.id+'/'}>{object.title}</a></h2><p>{object.summary}</p>{'studyType' in object&&<p class="caption">{object.studyType}</p>}<p class="object-accession">{object.museum}<br/>{object.identifierLabel||'Accession'} {object.accession}</p><a class="text-link" href={'/objects/'+object.id+'/'}>Open the object study ↗</a></div>
        </article>)}
      </div>
      <div class="object-comparison">
        <p class="eyebrow"><span class="star">✦</span> A comparative workshop</p><h2 class="small-title">One language. Different evidence.</h2><p>Compare how each material changes the questions you need to ask.</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Object comparison table"><table><thead><tr><th scope="col">Object</th><th scope="col">Start by observing</th><th scope="col">Then investigate</th></tr></thead><tbody>
          <tr><th scope="row"><a href="/objects/franconian-targe/">Painted targe</a></th><td>Physical outline and painted achievement</td><td>Alternative family attribution and the reverse decoration</td></tr>
          <tr><th scope="row"><a href="/objects/heraldic-glass/">Stained-glass shield</a></th><td>Colour areas and structural joins</td><td>Lighting, conservation, and original setting</td></tr>
          <tr><th scope="row"><a href="/objects/halewyn-ghistele-enamel/">Impalement in enamel</a></th><td>Two armorial compositions joined vertically</td><td>Patronage, workshop attribution, and possible larger ensemble</td></tr>
          <tr><th scope="row"><a href="/objects/vitelleschi-maiolica/">Arms on maiolica</a></th><td>A central shield within an ornamental border</td><td>Family identification, circle attribution, and the unknown commission</td></tr>
          <tr><th scope="row"><a href="/objects/cary-bookplate/">An engraved bookplate</a></th><td>Armorial display, name, and engraver’s inscription</td><td>Catalogue date range and evidence of actual use in a book</td></tr>
          <tr><th scope="row"><a href="/objects/lowlands-wax-seal/">Armorial wax impression</a></th><td>A shield, helmet, ornament, and separate mount</td><td>Material colour, catalogue uncertainty, and missing documentary context</td></tr>
          <tr><th scope="row"><a href="/objects/ghent-style-matrix/">A later pictorial matrix</a></th><td>Opposite arrangements on matrix and accompanying impression</td><td>Manufacture date, medieval style, and the impression’s separate history</td></tr>
          <tr><th scope="row"><a href="/objects/simon-de-varie/">An illuminated French leaf</a></th><td>Lettered scrolls, a portrait, and several armorial forms</td><td>Transcription, normalization, and reported overpainting</td></tr>
        </tbody></table></div>
        <p>Choose one claim about each object. Write down its source, what it establishes, and what additional evidence would change your confidence. A catalogue attribution and a visible feature should not receive the same kind of explanation.</p>
        <p><a href="/objects/seals/" class="btn btn-line">Try the seal evidence workshop ↗</a></p>
        <p><a href="/transcription-desk/" class="btn btn-line">Read a manuscript at the transcription desk ↗</a></p>
        <p><a href="/objects/compare/" class="btn btn-dark">Compare objects and keep research notes ↗</a></p>
        <a href="/seminars/05-material-culture/" class="text-link">Continue to the material-culture seminar ↗</a>
      </div>
      <p class="caption">Museum photographs use CC0; chapel photographs use public-domain releases or CC BY-SA 3.0. Each reproduction carries its own credit and rights link. The studies distinguish armorial objects from comparison pieces that test the limits of the term “heraldic”.</p>
      <a class="text-link" href="/armorial/">Explore the original teaching shields ↗</a>
    </div>
  </section>
  <script>
    import {matchesObjectStudy} from '../../lib/object-filters.js';
    const form=document.querySelector<HTMLFormElement>('#object-filters')!;
    const query=document.querySelector<HTMLInputElement>('#object-query')!;
    const material=document.querySelector<HTMLSelectElement>('#object-material')!;
    const period=document.querySelector<HTMLSelectElement>('#object-period')!;
    const cards=document.querySelectorAll<HTMLElement>('[data-object]');
    const status=document.querySelector<HTMLElement>('#object-count')!;
    const empty=document.querySelector<HTMLElement>('#object-empty')!;
    const filter=()=>{
      let count=0;
      cards.forEach(card=>{card.hidden=!matchesObjectStudy({searchText:card.dataset.search,material:card.dataset.material,periods:JSON.parse(card.dataset.periods||'[]')},{query:query.value,material:material.value,period:period.value});if(!card.hidden)count++;});
      status.textContent=count+' stud'+(count===1?'y':'ies')+' shown';empty.hidden=count!==0;
    };
    form.addEventListener('input',filter);form.addEventListener('change',filter);
    form.addEventListener('submit',event=>event.preventDefault());
    form.addEventListener('reset',()=>setTimeout(filter,0));

  </script>
  <style>
    .object-filters{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:16px;align-items:end}.object-filters label{display:grid;gap:8px;font-size:.8rem}.object-filters input,.object-filters select{width:100%;min-height:48px;padding:12px;border:1px solid var(--line);background:var(--white);color:var(--ink)}.object-card[hidden]{display:none}
    .object-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:25px 0 45px}
    .object-card{border:1px solid var(--line);background:var(--white);min-width:0}
    .object-plinth{display:flex;align-items:center;justify-content:center;height:300px;padding:22px;background:var(--paper-2)}
    .object-plinth :global(img){width:100%;height:100%;object-fit:contain}
    .object-body{padding:24px}.object-body h2{font:500 1.9rem/1.1 var(--serif);margin:13px 0}.object-body p{color:var(--ink-2);font-size:.86rem}
    .object-accession{font-size:.73rem!important;border-top:1px solid var(--line);padding-top:16px}.object-body .smallcaps{color:var(--red)}
    .object-comparison{background:var(--paper-2);border:1px solid var(--line);padding:clamp(20px,4vw,42px);margin-bottom:30px}
    .table-scroll{overflow-x:auto;margin:25px 0}table{border-collapse:collapse;width:100%;min-width:560px;font-size:.85rem}th,td{padding:15px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}th a{text-decoration:underline}
    @media(max-width:900px){.object-filters{grid-template-columns:1fr 1fr}.object-filters label:first-child{grid-column:1/-1}.object-grid{grid-template-columns:1fr}.object-plinth{height:330px}}
  </style>
</Base>
