---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import {TINCTURES,armsSVG,normalizeDesign,blazon} from '../lib/heraldry.js';
const demonstration=(field:string,charge:string='none')=>({field,secondary:'argent',division:'none',ordinary:'none',ordinaryTincture:'argent',charge,chargeTincture:'or',count:1});
const fields=['or','argent','gules','azure','sable','vert','purpure'];
const plural=(key:string)=>TINCTURES[key].kind==='metal'?'metal':'colour';
const chart=fields.map(key=>({key,...TINCTURES[key]}));
const start=normalizeDesign({field:'azure',ordinary:'none',charge:'mullet',chargeTincture:'or',count:1});
const sources=[
{title:'Heraldry for Beginners',type:'The Heraldry Society',url:'https://www.heraldicdesign.com/docs/heraldry_for_beginners.pdf',description:'An introductory PDF with a color-code chart, conventions, and an explanation of furs.'},
{title:'The Herald Painter',type:'The Heraldry Society',url:'https://www.theheraldrysociety.com/articles/the-herald-painter/',description:'An artist explains why the hatching system was useful in engraving and books.'},
{title:"Romania's legally specified hatching",type:'Romanian Parliament',url:'https://legislatie.just.ro/Public/DetaliiDocument/2381',description:'Article 2 places monochrome heraldic hatching into the legal specification of Romania’s state coat of arms.'},
{title:'A Brief Heraldic Guide',type:'Bibliographical Society',url:'https://armorial.bibsoc.org.uk/sites/default/files/Brief-heraldic-guide.doc.pdf',description:'A historically informed introduction to the Petra Sancta scheme on bookbindings.'}
];
---
<Base title="The Tincture Laboratory" description="Explore the seven principal heraldic tinctures, the conventional rule of tincture, and historical black-and-white hatching. Change field and charge live.">
  <PageIntro eyebrow="Colour, pattern & legibility" title="The tincture laboratory." description="What happens when you take the colour out of a coat of arms? The language survives. Study the traditional palette, test its contrast, and discover how engravers used pattern to make colour readable without colour."/>
  <section class="section">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> The seven principal tinctures</p><h2 class="section-title">Two metals.<br/>Five colours.</h2></div><p>A tincture is more than a hex code. The same Azure remains blue in oil paint, embroidery, stone carving, print, and digital art.</p></div>
      <div class="tincture-collection">
        {chart.map((entry,i)=><article class="tincture-card">
          <div class="tincture-sample" style={'background:'+entry.value} aria-label={entry.name+' in its representative hue'}><div set:html={armsSVG(demonstration(entry.key),'tincture-c-'+i)}></div></div>
          <div class="tincture-sample hatching-sample" aria-label={'Petra Sancta engraved depiction of '+entry.name}><div set:html={armsSVG(demonstration(entry.key),'tincture-h-'+i,true)}></div></div>
          <div class="tincture-description"><span class="smallcaps" style="color:var(--red)">{plural(entry.key)} · {String(i+1).padStart(2,'0')}</span><h3>{entry.name}</h3><p>{entry.meaning} <span style="color:var(--muted)">→ engraved hatching</span></p></div>
        </article>)}
      </div>
      <div class="notice-box" style="margin-top:25px"><strong>This is the Petra Sancta system.</strong><p>The illustrated hatchings represent one historically influential convention, popularized in the seventeenth century, rather than a universal method in all periods or regions. Dots represent Or; unmarked white represents Argent; vertical, horizontal, crossed, and opposite diagonal lines represent the principal colours. <a href="https://www.theheraldrysociety.com/articles/the-herald-painter/" target="_blank" rel="noopener noreferrer" style="text-decoration:underline">Learn how engravers used it ↗</a></p></div>
    </div>
  </section>
  <section class="section section-toned">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> Change one thing</p><h2 class="section-title">A contrast<br/>experiment.</h2></div><p>A gold star on blue. A blue star on gold. A red star on blue. The shapes don't change—yet the visual result certainly does.</p></div>
      <div class="tincture-lab">
        <div class="tincture-controls">
          <h3 class="small-title">01 · Choose the field</h3>
          <div class="swatch-strip" id="tincture-field-picker" role="group" aria-label="Choose the field tincture">
            {chart.map(entry=><button class:list={['tincture-picker',entry.key===start.field&&'selected']} type="button" data-field={entry.key} aria-pressed={entry.key===start.field} title={'Field '+entry.name}>
              <span class="swatch-pill" style={'background:'+entry.value}></span><span>{entry.name}</span>
            </button>)}
          </div>
          <h3 class="small-title" style="margin-top:33px">02 · Choose the charge</h3>
          <div class="swatch-strip" id="tincture-charge-picker" role="group" aria-label="Choose the charge tincture">
            {chart.map(entry=><button class:list={['tincture-picker',entry.key===start.chargeTincture&&'selected']} type="button" data-charge={entry.key} aria-pressed={entry.key===start.chargeTincture} title={'Charge '+entry.name}>
              <span class="swatch-pill" style={'background:'+entry.value}></span><span>{entry.name}</span>
            </button>)}
          </div>
          <div class="lab-feedback" role="status" aria-live="polite">
            <p class="eyebrow"><span class="star">✦</span> The design convention</p>
            <h3 id="tincture-judgment">A clean contrast.</h3>
            <p id="tincture-feedback">The usual metal-on-colour convention is satisfied here.</p>
            <p class="caption">An advisory about simple contrast is neither legal advice nor a determination of heraldic validity.</p>
          </div>
          <a class="btn btn-dark" id="tincture-open-atelier" href="/atelier/">Take this shield to the Atelier ↗</a>
        </div>
        <div class="tincture-results">
          <div class="tincture-preview"><span class="smallcaps">In pigment</span><div id="tincture-colour-art" class="shield-illustration" set:html={armsSVG(start,'tincture-live-colour')}></div></div>
          <div class="tincture-preview monochrome"><span class="smallcaps">In engraving</span><div id="tincture-hatched-art" class="shield-illustration" set:html={armsSVG(start,'tincture-live-hatch',true)}></div></div>
          <p class="tincture-caption" id="tincture-blazon" aria-live="polite">{blazon(start)}</p>
        </div>
      </div>
      <p class="caption" style="margin-top:15px">The shapes are identical. The right-hand illustration substitutes conventional texture patterns for their tinctures.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> All forty-nine combinations</p><h2 class="section-title">The contrast<br/>matrix.</h2></div><p>Choose a field (row) and a charge (column). The darker cells aren't necessarily forbidden; they are combinations the introductory convention asks you to reconsider.</p></div>
      <div class="matrix-scroll">
        <table class="contrast-matrix">
          <caption>Traditional metal-colour pairing matrix. A circle indicates unlike categories; a diamond indicates the same category and warrants review.</caption>
          <thead><tr><th scope="col">Field ↓ / Charge →</th>{fields.map(k=><th scope="col"><span class="matrix-tincture" style={'background:'+TINCTURES[k].value}></span>{TINCTURES[k].name}</th>)}</tr></thead>
          <tbody>{fields.map(field=><tr><th scope="row"><span class="matrix-tincture" style={'background:'+TINCTURES[field].value}></span>{TINCTURES[field].name}</th>{fields.map(charge=><td><button type="button" class:list={['matrix-cell',TINCTURES[field].kind===TINCTURES[charge].kind?'matrix-caution':'matrix-good']} data-matrix-field={field} data-matrix-charge={charge} aria-label={TINCTURES[field].name+' field with '+TINCTURES[charge].name+' charge: '+(TINCTURES[field].kind===TINCTURES[charge].kind?'review contrast':'traditional contrasting categories')} title={TINCTURES[field].name+' with '+TINCTURES[charge].name}>{TINCTURES[field].kind===TINCTURES[charge].kind?'◇':'●'}</button></td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="caption">● different categories: ordinarily strong traditional contrast. ◇ same category: ordinarily discouraged for simple layering. The matrix intentionally omits divided fields, furs, natural-colour charges, and historical exceptions.</p>
      <div class="notice-box" style="margin-top:25px"><strong>The rule is more useful than a decree.</strong><p>Metal on colour or colour on metal is a very good starting point. But the full practice of heraldry contains furs, partitions, counterchanging, charges proper, and historically accepted arms that cannot be fairly analyzed by this simple table. Study the <a href="/academy/tinctures/" style="text-decoration:underline">tincture unit</a> before using the checker as an absolute rule.</p></div>
    </div>
  </section>
  <section class="section section-toned">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> Read the originals</p><h2 class="section-title">Colour, recorded.</h2></div><p>Hatching was a practical solution to the problem of representing colour where paint or colour printing was unavailable or uneconomical.</p></div>
      <div class="field-grid">
        {sources.map(item=><div class="field-panel"><span class="smallcaps" style="color:var(--red)">{item.type}</span><h3 style="margin-top:15px">{item.title}</h3><p>{item.description}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">Consult the source ↗</a></div>)}
      </div>
    </div>
  </section>
  <script>
    import {TINCTURES,normalizeDesign,armsSVG,blazon} from '../lib/heraldry.js';
    let field='azure',charge='or';
    const ink=document.querySelector<HTMLElement>('#tincture-colour-art');
    const hatch=document.querySelector<HTMLElement>('#tincture-hatched-art');
    const description=document.querySelector<HTMLElement>('#tincture-blazon');
    const judgment=document.querySelector<HTMLElement>('#tincture-judgment');
    const feedback=document.querySelector<HTMLElement>('#tincture-feedback');
    const atelier=document.querySelector<HTMLAnchorElement>('#tincture-open-atelier');
    const buttons=document.querySelectorAll<HTMLButtonElement>('[data-field],[data-charge]');
    const render=()=>{
      const design=normalizeDesign({field,division:'none',ordinary:'none',charge:'mullet',chargeTincture:charge,count:1});
      if(ink)ink.innerHTML=armsSVG(design,'lab-colour-live');
      if(hatch)hatch.innerHTML=armsSVG(design,'lab-hatch-live',true);
      if(description)description.textContent=blazon(design);
      const same=TINCTURES[field].kind===TINCTURES[charge].kind;
      if(judgment)judgment.textContent=same?'A contrast to reconsider.':'A conventionally strong contrast.';
      if(feedback)feedback.textContent=same?'Both elements are in the '+TINCTURES[field].kind+' category. The simple rule of tincture discourages this layering.':'A '+TINCTURES[charge].kind+' charge stands on a '+TINCTURES[field].kind+' field. This fits the introductory contrast convention.';
      if(atelier)atelier.href='/atelier/?'+new URLSearchParams(Object.entries(design).map(([k,v])=>[k,String(v)])).toString();
      buttons.forEach(b=>{
        const selected=(b.dataset.field!==undefined&&b.dataset.field===field)||(b.dataset.charge!==undefined&&b.dataset.charge===charge);
        b.classList.toggle('selected',selected);b.setAttribute('aria-pressed',String(selected));
      });
      document.querySelectorAll<HTMLButtonElement>('[data-matrix-field]').forEach(b=>{
        b.classList.toggle('current',b.dataset.matrixField===field&&b.dataset.matrixCharge===charge);
      });
    };
    document.querySelectorAll<HTMLButtonElement>('[data-field]').forEach(b=>b.addEventListener('click',()=>{field=b.dataset.field||'azure';render();}));
    document.querySelectorAll<HTMLButtonElement>('[data-charge]').forEach(b=>b.addEventListener('click',()=>{charge=b.dataset.charge||'or';render();}));
    document.querySelectorAll<HTMLButtonElement>('[data-matrix-field]').forEach(b=>b.addEventListener('click',()=>{
      field=b.dataset.matrixField||'azure';charge=b.dataset.matrixCharge||'or';render();
      document.querySelector('.tincture-lab')?.scrollIntoView({behavior:'smooth',block:'center'});
    }));
    render();
  </script>
</Base>
