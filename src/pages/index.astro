---
import Base from '../layouts/Base.astro';
import Shield from '../components/Shield.astro';
import lessons from '../data/course.json';
import glossary from '../data/glossary.json';
import showcase from '../data/showcase.json';
import { blazon } from '../lib/heraldry.js';
import { getCollection } from 'astro:content';
import { chapterReadMinutes } from '../lib/foundation.js';
import worldSources from '../data/world-sources.json';
import objects from '../data/objects.json';
import ObjectImage from '../components/ObjectImage.astro';
const worldCount=(await getCollection('traditions')).length;
const foundation=await getCollection('foundation');
const lessonMinutes=(slug:string)=>chapterReadMinutes(foundation.find(chapter=>chapter.id===slug)?.body);
const example={field:'azure',division:'none',ordinary:'fess',ordinaryTincture:'or',charge:'martlet',chargeTincture:'gules',count:3};
const cards=[
  {symbol:'Ⅰ',title:'Learn the language',description:'Twelve self-paced university-style units. From the first field to the law of arms.',link:'/academy/',action:'Enter the academy'},
  {symbol:'✦',title:'Draw the impossible',description:'Change colours, charges and ordinaries. Watch the heraldic grammar respond.',link:'/atelier/',action:'Open the atelier'},
  {symbol:'⌕',title:'Read the evidence',description:'A multilingual primary-source atlas, a field guide and links to the actual authorities.',link:'/resources/',action:'Explore the sources'}
];
---
<Base title="The language of arms" description="Learn heraldry through twelve written lessons, original illustrated armory, interactive shield design, blazoning, practical exercises, and scholarly sources.">
  <section class="hero">
    <div class="wrap hero-layout">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-on-dark"><span class="star">✦</span> A new kind of heraldic education</p>
        <h1>THE<br/>LANGUAGE <em>of arms.</em></h1>
        <p class="hero-description">A thousand years of symbols. A language you can learn. A free, interactive academy where history, art, geometry and identity finally speak to one another.</p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="/academy/">Begin your education <span aria-hidden="true">↗</span></a><a class="btn btn-light-line" href="/lecture/the-visual-language/">Enter the lecture hall ▶</a>
          <a class="btn btn-light-line" href="/atelier/">Enter the atelier <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">No tuition <span>✦</span> No account <span>✦</span> Curiosity required</p>
      </div>
      <div class="hero-art" aria-label="Original shield illustration of three red heraldic martlets on a golden fess over blue">
        <div class="hero-annotation top"><i></i> A living visual language</div>
        <div class="hero-frame"><Shield design={example} id="home-featured-shield" /></div>
        <div class="hero-annotation bottom"><i></i> Shield study no. 001</div>
      </div>
    </div>
  </section>
  <div class="stat-strip">
    <div class="wrap stat-grid">
      <div class="stat"><span class="stat-number">12</span><span class="stat-label">Course<br/>units</span></div>
      <div class="stat"><span class="stat-number">{glossary.length}</span><span class="stat-label">Words in the<br/>lexicon</span></div>
      <div class="stat"><span class="stat-number">{showcase.length}</span><span class="stat-label">Original shield<br/>studies</span></div>
      <div class="stat"><span class="stat-number">∞</span><span class="stat-label">Possible things<br/>to learn</span></div>
    </div>
  </div>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow"><span class="star">✦</span> Not another family crest shop</p>
      <p class="intro-statement">Heraldry is <strong>part visual grammar, part historical evidence, part living art.</strong> We built a place to learn all three—without the mythology, the gatekeeping, or the insistence that every surname comes with a matching coffee mug.</p>
    </div>
  </section>
  <section class="section section-toned" id="explore">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> Choose your entrance</p><h2 class="section-title">Many doors.<br/>One language.</h2></div><p>Read, make, question. Every major concept is linked to an illustration, an exercise, or a source worth following.</p></div>
      <div class="feature-grid">
        {cards.map(card => <a class="card feature-card" href={card.link}><span class="feature-icon">{card.symbol}</span><h3>{card.title}</h3><p>{card.description}</p><span class="smallcaps" style="color:var(--red)">{card.action}</span><span class="feature-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> Our flagship studio</p><h2 class="section-title">The blazon<br/>atelier.</h2></div><p>Try a shield. Change its composition. See how a formal heraldic description emerges from your decisions.</p></div>
      <div class="teaser-stage">
        <div>
          <p class="eyebrow"><span class="star">✦</span> From image to language</p>
          <h3>Paint a shield.<br/>Read its story.</h3>
          <p>A small, exacting laboratory for building simplified coats of arms with live SVG, a downloadable design, an introductory blazon, and thoughtful warnings about contrast.</p>
          <p class="blazon-quote">{blazon(example)}</p>
          <a class="btn btn-gold" href="/atelier/">Make your own study <span aria-hidden="true">↗</span></a> <a class="btn btn-light-line" href="/decoder/" style="margin-top:9px">Decode a blazon ↗</a>
        </div>
        <Shield design={example} id="home-teaser-shield" />
      </div>
    </div>
  </section>
  <section class="section section-toned" id="objects">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> The material evidence</p><h2 class="section-title">Real objects.<br/>Better questions.</h2></div><div><p>A painted shield, stained glass, enamel, maiolica, and a bookplate. Examine museum photographs and learn to separate observation, attribution, and uncertainty.</p><a href="/objects/" class="text-link">Enter the object-study collection ↗</a></div></div>
      <div class="home-objects">{objects.map(object=><a href={'/objects/'+object.id+'/'}><div><ObjectImage object={object}/></div><span class="smallcaps">{object.culture} · {object.date}</span><h3>{object.title}</h3><span class="text-link">Investigate the object ↗</span></a>)}</div>
    </div>
  </section>
  <section class="section section-toned">
    <div class="wrap">
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> A real course, not a list of links</p><h2 class="section-title">The academy.</h2></div><div><p>Start in the twelfth century. Finish by researching and designing a defensible original armorial study.</p><a class="text-link" href="/academy/">View the full curriculum ↗</a></div></div>
      <div class="module-grid">
        {lessons.slice(0,6).map(lesson => <a class="card module-card" href={'/academy/'+lesson.slug+'/'}><div class="module-top"><span class="module-number">{String(lesson.number).padStart(2,'0')}</span><span class="module-duration">About {lessonMinutes(lesson.slug)} min reading</span></div><h3>{lesson.title}</h3><p>{lesson.description}</p><div class="module-foot"><span>{lesson.eyebrow}</span><span aria-hidden="true">↗</span></div></a>)}
      </div>
      <div style="text-align:center;margin-top:35px"><a href="/academy/" class="btn btn-dark">All twelve units <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  
  <section class="section section-dark" id="world">
    <div class="wrap split" style="align-items:center">
      <div>
        <p class="eyebrow eyebrow-on-dark"><span class="star">✦</span> The international research programme</p>
        <h2 class="section-title">The world has<br/>more than one<br/>law of arms.</h2>
        <p class="section-subtitle" style="margin-top:20px">French manuscripts. German Wappenrollen. Polish heraldic clans. Flemish legislation. Portuguese royal armorials. Japanese kamon. The story gets much bigger when we start reading the original languages.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
          <a href="/traditions/" class="btn btn-gold">Explore the world ↗</a>
          <a href="/source-atlas/" class="btn btn-light-line">Read the source atlas ↗</a><a href="/translation-lab/" class="btn btn-light-line">Translate the sources ↗</a>
        </div>
      </div>
      <div style="background:#562739;padding:clamp(23px,4vw,45px);border:1px solid #976577">
        <p class="eyebrow eyebrow-on-dark"><span class="star">✦</span> The scholarly promise</p>
        <p style="font:italic clamp(1.8rem,3vw,3rem)/1.24 var(--serif);color:var(--gold-light);margin:0 0 27px">A thousand years of arms, without making England the centre of the world.</p>
        <div style="display:grid;gap:13px;color:#eedbd0;font-size:.82rem">
          <span>{worldCount} original comparative research chapters</span>
          <span>{worldSources.length} original-language research dossiers</span>
          <span>{new Set(worldSources.map(s=>s.language)).size} source languages</span>
          <span>Graduate primary-source assignments</span>
        </div>
        <a href="/seminars/" class="text-link" style="color:var(--gold-light);display:inline-block;margin-top:30px">Beyond the undergraduate course ↗</a>
      </div>
    </div>
  </section>
<section class="quote-band"><div class="wrap"><blockquote>“A blazon is something rather extraordinary: a painting written as instructions.”</blockquote><cite>The idea behind this project</cite></div></section>
  <section class="section">
    <div class="wrap split" style="align-items:center">
      <div>
        <p class="eyebrow"><span class="star">✦</span> Beyond the classroom</p>
        <h2 class="section-title">Be curious.<br/>Be critical.</h2>
        <p style="margin:1.5rem 0;color:var(--muted);max-width:500px">Is that really a crest? Who had the right to bear those arms? Why does Scottish matriculation matter? The most interesting part of heraldry is usually the evidence behind the drawing.</p>
        <a href="/field-guide/" class="btn btn-line">Read the field guide ↗</a><a href="/tinctures/" class="btn btn-quiet" style="margin-left:8px;margin-top:8px">Explore the colour laboratory ↗</a>
      </div>
      <div class="field-panel" style="background:#e9e0d1">
        <p class="eyebrow"><span class="star">✦</span> The cardinal distinction</p>
        <h3 style="font:500 2.7rem/1.02 var(--serif);margin-bottom:1.1rem">A crest is not<br/>a coat of arms.</h3>
        <p>Neither is a surname proof of entitlement. This school treats heraldry as a historical discipline, a living artistic practice and a set of jurisdiction-specific traditions.</p>
        <a class="text-link" href="/resources/">Meet the authorities ↗</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .home-objects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.home-objects>a{background:var(--white);border:1px solid var(--line);padding:22px;min-width:0}.home-objects>a>div{height:260px;display:flex;align-items:center;justify-content:center;margin-bottom:22px}.home-objects :global(img){width:100%;height:100%;object-fit:contain}.home-objects .smallcaps{color:var(--red)}.home-objects h3{font:500 1.9rem/1.12 var(--serif);margin:14px 0 20px}.home-objects .text-link{font-size:.8rem}
  @media(max-width:900px){.home-objects{grid-template-columns:1fr}}
</style>
