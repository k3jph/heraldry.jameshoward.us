---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ObjectImage from '../../components/ObjectImage.astro';
import {witnesses,FIELDS} from '../../lib/transcription.js';
import {pairContext,COMPARISON_FIELDS,READING_FIELDS} from '../../lib/collation.js';
const initial=[witnesses.find(w=>w.id==='simon-de-varie-2')!,witnesses.find(w=>w.id==='simon-de-varie-2v')!];
---
<Base title="Compare Manuscript Witnesses" description="Compare two located manuscript witnesses, import transcription drafts, inspect exact text differences, explain readings in a located apparatus, and export a source-linked comparison.">
  <PageIntro eyebrow="The manuscript comparison bench" title="Same words. Another witness." description="Put two located sources beside each other. Compare what you can read, explain the differences, and keep the evidence attached to the argument."/>
  <section class="section"><div class="wrap">
    <p><a href="/transcription-desk/" class="text-link">← Single-witness transcription desk</a> · <a href="/transcription-desk/collation/" class="text-link">Read the comparison workshop ↗</a></p>
    <div class="pair-toolbar">{['left','right'].map((side,i)=><label for={'witness-'+side}><span class="smallcaps">{side==='left'?'Left witness':'Right witness'}</span><select id={'witness-'+side}>{witnesses.map(w=><option value={w.id} selected={w.id===initial[i].id}>{w.label}</option>)}</select></label>)}<button id="swap-witnesses" class="btn btn-line" type="button">Swap witnesses ⇄</button></div>
    <p id="pair-context" class="notice-box">{pairContext(initial)}</p>
    <p id="comparison-status" class="caption" role="status" aria-live="polite">Each ordered pair has its own browser draft. Export JSON for a portable copy.</p>
    <div class="witness-pair">{initial.map((w,i)=>{const side=i===0?'left':'right';return <article class="source-card" id={'source-'+side}>
      <p class="eyebrow">{i===0?'Left':'Right'} source</p><h2 data-title>{w.title}</h2><p class="locator" data-locator>{w.locator}</p>
      <div class="zoom-tools"><label for={'zoom-'+side}>Image width <input type="range" id={'zoom-'+side} min="100" max="300" step="25" value="100"/><output id={'zoom-value-'+side} for={'zoom-'+side}>100%</output></label><button class="chip" id={'fit-'+side} type="button">Fit width</button></div>
      <div class="source-image" data-picture tabindex="0" role="region" aria-label={(i===0?'Left':'Right')+' witness scrollable image'}><ObjectImage object={w} loading="eager"/></div>
      <a data-external href={w.url} class="btn btn-dark" target="_blank" rel="noopener" hidden>Open source facsimile at the archive ↗</a><p><a data-full href={w.imageSource} target="_blank" rel="noopener" class="text-link">Full source image ↗</a></p>
      <dl><div><dt>Repository</dt><dd data-repository>{w.repository}</dd></div><div><dt>Catalogue date</dt><dd data-date>{w.date}</dd></div></dl><p data-scope>{w.scope}</p>
      <details><summary>Source credit and image rights</summary><p data-credit>{w.credit}</p><p data-rights>{w.rights}</p><a data-rights-link href={w.rightsUrl}>Rights record ↗</a></details>
      <div class="source-links"><a data-record href={w.url}>Institutional record ↗</a><a data-desk-link href={'/transcription-desk/?witness='+w.id}>Edit this witness at the desk ↗</a></div>
      <section class="reading-panel"><h3>Reading for this comparison</h3><p class="caption">Enter your reading here, or bring in a single-witness desk draft. This comparison keeps its own copy; editing it does not change the desk draft.</p>
        <div class="reading-load"><button class="chip" id={'use-desk-'+side} type="button">Preview saved desk draft</button><label for={'reading-file-'+side}><span>Or import this witness’s desk JSON</span><input id={'reading-file-'+side} type="file" accept=".json,application/json"/></label></div>
        <p class="caption" id={'reading-meta-'+side}>Origin: manual · no apparatus entries yet.</p>
        <details><summary>Retained editor notes and original apparatus</summary><pre class="reading-context" id={'reading-context-'+side}>Load a desk draft to inspect its original notes and apparatus here.</pre></details>
        {READING_FIELDS.map(key=>{const field=FIELDS.find(f=>f.id===key)!;return <label for={'reading-'+side+'-'+key}><span>{field.label}</span><small>{field.prompt}</small><textarea id={'reading-'+side+'-'+key} rows={key==='scope'?2:4} maxlength="50000"></textarea></label>;})}
        <p class="caption">Imported editor details, notes, and original apparatus entries are preserved in the comparison exports. Use the single-witness desk to revise that original apparatus.</p>
      </section>
    </article>;})}</div>
    <section class="difference-panel"><p class="eyebrow">A check on the entered strings</p><h2>What changed in the text?</h2><p>The preview compares your entered text exactly. It retains case, accents, punctuation, and whitespace. Visually identical letters can differ in their Unicode encoding and will be highlighted; the tool does not automatically normalize either reading. It does not read handwriting, judge a translation, or establish which version came first.</p><div class="difference-tools"><label for="comparison-layer">Text layer <select id="comparison-layer"><option value="diplomatic">Diplomatic transcription</option><option value="normalized">Normalized reading</option><option value="translation">English translation</option></select></label><button id="run-comparison" type="button" class="btn btn-dark">Compare entered text</button></div><p class="difference-legend"><span>Unmarked: shared text</span><span class="left-only">Left only: struck through</span><span class="right-only">Right only: underlined</span></p><p id="difference-status" class="caption" role="status" aria-live="polite">Enter both readings, then run the comparison.</p><pre id="text-difference" role="region" aria-label="Entered-text difference preview" tabindex="0"></pre></section>
    <section class="comparison-notebook"><p class="eyebrow">Make the comparison accountable</p><h2>The argument and apparatus.</h2><form id="comparison-form">{COMPARISON_FIELDS.map(f=><label for={'comparison-'+f.id}><span>{f.label}</span><small>{f.prompt}</small><textarea id={'comparison-'+f.id} rows={f.id==='question'?2:4} maxlength="50000"></textarea></label>)}</form>
      <h3>Located comparisons</h3><p>Pair the actual locations: lower scroll with lower scroll, upper scroll with collar, or a visible feature with a separately identified comparison. Describe your evidence and leave unresolved alternatives explicit.</p><p id="alignment-count" class="caption">0 / 100 located comparisons</p><div id="alignment-rows"></div><button id="add-alignment" class="btn btn-line" type="button">Add located comparison +</button>
      <div class="comparison-actions"><button id="comparison-markdown" class="btn btn-dark" type="button">Export Markdown ↓</button><button id="comparison-json" class="btn btn-line" type="button">Export portable JSON ↓</button><button id="comparison-link" class="chip" type="button">Copy pair link</button></div>
      <div class="import-panel"><label for="comparison-file"><strong>Restore a complete comparison</strong><small>Use a comparison-bench JSON export, up to 1 MB. Single-witness desk files belong in the witness columns above.</small><input id="comparison-file" type="file" accept=".json,application/json"/></label><div id="comparison-import-review" hidden><h3>Review before loading</h3><p id="comparison-import-summary"></p><pre id="comparison-import-preview"></pre><div class="comparison-actions"><button id="comparison-backup" class="chip" type="button">Export destination comparison first</button><button id="comparison-load" class="btn btn-dark" type="button">Load reviewed draft</button><button id="comparison-cancel" class="chip" type="button">Cancel</button></div></div></div>
      <p class="caption">Notes stay in this browser. Export before clearing browser data. Shared pair links contain no readings or notes. Review statuses describe your work; “checked” does not imply museum or specialist approval.</p>
    </section>
    <noscript><div class="notice-box"><strong>The two source dossiers and <a href="/transcription-desk/collation/">comparison lesson</a> remain readable without JavaScript.</strong><p>Selection, draft loading, zoom, text highlighting, autosave, and exports require JavaScript. Keep a separate document if those tools are unavailable.</p></div></noscript>
  </div></section>
  <script>
    import {mountComparison} from '../../lib/collation-controller.js';
    mountComparison(document,window);
  </script>
  <style>
    .pair-toolbar{display:grid;grid-template-columns:1fr 1fr auto;gap:20px;align-items:end;margin:30px 0}.pair-toolbar label{display:grid;gap:9px;min-width:0}.pair-toolbar select,.difference-tools select{width:100%;padding:13px;background:white;border:1px solid var(--line);font:inherit;min-width:0}.witness-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px;margin:25px 0 40px}.source-card{border:1px solid var(--line);background:white;padding:clamp(18px,3vw,28px);min-width:0}.source-card h2,.difference-panel h2,.comparison-notebook h2{font:500 2.2rem/1.1 var(--serif);margin:15px 0}.source-card h3,.comparison-notebook h3{font:500 1.7rem/1.2 var(--serif);margin:25px 0 15px}.source-card p{font-size:.85rem;line-height:1.7}.source-card .locator{font-weight:650}.source-card dl>div{display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px;border-bottom:1px solid var(--line);padding:10px 0;font-size:.82rem}.source-card dt{color:var(--muted)}.source-card dd{margin:0}.source-image{height:490px;overflow:auto;background:var(--paper-2);border:1px solid var(--line)}.source-image :global(img){display:block;width:100%;max-width:none;height:auto}.zoom-tools{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:20px 0 10px}.zoom-tools label{display:flex;align-items:center;gap:10px;font-size:.77rem;flex-wrap:wrap}.zoom-tools input{max-width:145px}.source-card details{margin:20px 0;font-size:.8rem}.source-card summary{cursor:pointer;font-weight:650}.source-links{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem;text-decoration:underline}.reading-panel{margin-top:30px;border-top:2px solid var(--red)}.reading-panel>label,.comparison-notebook label{display:grid;gap:8px;margin:20px 0}.reading-panel label>span,.comparison-notebook label>span{font-weight:650}.reading-panel small,.comparison-notebook small{font-size:.77rem;color:var(--ink-2);line-height:1.65}.reading-panel textarea,.comparison-notebook textarea{width:100%;padding:13px;border:1px solid var(--line);background:white;font:inherit;line-height:1.6;resize:vertical}.reading-load{display:grid;gap:16px}.reading-load label{display:grid;gap:8px;font-size:.78rem}.reading-load input,.import-panel input{max-width:100%;font-size:.78rem}.difference-panel,.comparison-notebook{padding:clamp(20px,4vw,40px);background:var(--paper-2);border:1px solid var(--line);margin:35px 0}.difference-tools{display:flex;align-items:end;gap:15px;flex-wrap:wrap}.difference-tools label{display:grid;gap:8px;font-size:.8rem}.difference-legend{display:flex;flex-wrap:wrap;gap:15px;font-size:.8rem}.left-only{background:#f5d9d4;text-decoration:line-through}.right-only{background:#d7e9df;text-decoration:underline}.difference-panel pre,#comparison-import-preview{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.95rem;line-height:1.8;max-height:350px;overflow:auto;background:white;padding:20px;border:1px solid var(--line)}#text-difference :global(del){background:#f5d9d4;color:#702c22}#text-difference :global(ins){background:#d7e9df;color:#214a39}.comparison-notebook form{display:grid;grid-template-columns:1fr 1fr;gap:0 25px}.comparison-notebook form label:first-child{grid-column:1/-1}.comparison-notebook :global(fieldset){display:grid;grid-template-columns:1fr 1fr;gap:0 18px;margin:20px 0;padding:22px;border:1px solid var(--line);min-width:0}.comparison-notebook :global(legend){font-weight:650;padding:0 8px}.comparison-notebook :global(fieldset label){display:grid;gap:8px;min-width:0;margin:12px 0;font-size:.82rem}.comparison-notebook :global(fieldset label:last-of-type){grid-column:1/-1}.comparison-notebook :global(fieldset textarea),.comparison-notebook :global(fieldset select){font:inherit;width:100%;padding:12px;border:1px solid var(--line);background:white;resize:vertical}.comparison-actions{display:flex;gap:10px;flex-wrap:wrap;margin:25px 0}.import-panel{border-top:1px solid var(--line);padding-top:20px;margin-top:25px}#comparison-import-review{padding:20px;border:1px solid var(--line);margin:20px 0}
    .reading-context{white-space:pre-wrap;overflow-wrap:anywhere;max-height:320px;overflow:auto;background:var(--paper-2);padding:15px;font-size:.8rem;line-height:1.7}
    @media(max-width:850px){.pair-toolbar,.witness-pair,.comparison-notebook form{grid-template-columns:1fr}.comparison-notebook form label{grid-column:1!important}.source-image{height:420px}.comparison-notebook :global(fieldset){grid-template-columns:1fr}.comparison-notebook :global(fieldset label){grid-column:1!important}}
  </style>
</Base>
