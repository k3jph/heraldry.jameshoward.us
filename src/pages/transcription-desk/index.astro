---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ObjectImage from '../../components/ObjectImage.astro';
import {witnesses,FIELDS} from '../../lib/transcription.js';
---
<Base title="Manuscript Transcription Desk" description="Read French manuscript mottoes and a Portuguese armorial witness, keep diplomatic and normalized readings separate, annotate uncertainties, and export or restore a source-linked working draft.">
  <PageIntro eyebrow="From the letter to the argument" title="The transcription desk." description="A manuscript has more to say than its caption. Look closely, record what you see, and leave a trail another reader can follow."/>
  <section class="section"><div class="wrap">
    <div class="desk-heading"><label for="desk-witness"><span class="smallcaps">Choose a manuscript witness</span><select id="desk-witness">{witnesses.map(w=><option value={w.id}>{w.label}</option>)}</select></label><a href="/transcription-desk/reading/" class="btn btn-line">Read the manuscript workshop ↗</a></div>
    <p id="desk-status" class="caption" role="status" aria-live="polite">Notes are saved in this browser when JavaScript is available. Export JSON to keep a portable copy.</p>
    <p><a href="/transcription-desk/compare/" class="text-link">Compare two witnesses, readings, and editorial decisions ↗</a></p>
    <div class="desk-grid">
      <div class="witness-column">{witnesses.map((w,i)=><article class="witness" data-witness={w.id}>
        <p class="eyebrow">{w.language}</p><h2>{w.title}</h2><p class="locator">{w.locator}</p>
        {'image' in w?<>
          <div class="zoom-tools"><label for={'zoom-'+w.id}>Image width <input type="range" min="100" max="300" step="25" value="100" id={'zoom-'+w.id} data-zoom/><output data-zoom-value for={'zoom-'+w.id}>100%</output></label><button class="chip" type="button" data-fit>Fit width</button></div>
          <div class="facsimile-viewport" tabindex="0" role="region" aria-label={'Scrollable facsimile of '+w.locator}><ObjectImage object={w} loading={i===0?'eager':'lazy'}/></div>
          <p class="caption">Increase image width, then scroll to inspect the lettering. The full leaf is preserved. <a href={w.imageSource} target="_blank" rel="noopener">Open full-resolution image ↗</a></p>
        </>:<div class="source-only"><span class="smallcaps">Facsimile at the archive</span><h3>Read beside the original source.</h3><p>The archive identifies folio 87 on PDF page 23. Image reuse has not been verified, so open that page in another tab beside this desk. If the file does not open, record the access limit rather than guessing at the hand.</p><a href={w.url} target="_blank" rel="noopener" class="btn btn-dark">Open archive PDF, page 23 ↗</a></div>}
        <dl><div><dt>Repository</dt><dd>{w.repository}</dd></div><div><dt>Date</dt><dd>{w.date}</dd></div><div><dt>Maker</dt><dd>{w.creator}</dd></div></dl>
        <p>{w.scope}</p><div class="witness-prompt"><h3>Your first reading</h3><p>{w.prompt}</p></div>
        <details><summary>Compare the modern reference reading</summary><p>{w.referenceLabel}</p><blockquote lang={w.referenceLanguage}>{w.reference}</blockquote><p class="caption"><a href={w.referenceUrl}>Reference source ↗</a>. A caption or catalogue reading is a separate witness; it does not silently fill your transcription.</p></details>
        <p class="caption">{w.credit}. Source consulted {w.accessed}.</p><p class="caption">{w.rights} <a href={w.rightsUrl}>Rights source ↗</a></p><a href={w.url} target="_blank" rel="noopener" class="text-link">Institutional source record ↗</a>
        {'manifest' in w&&<p class="caption"><a href={w.manifest}>IIIF manifest</a> · Image canvas labeled {w.folio}</p>}
      </article>)}</div>
      <div class="draft-column"><p class="eyebrow">An accountable working draft</p><h2>Your edition begins here.</h2><p class="caption">The desk preserves your text. It does not check the handwriting or certify a translation. “Checked” is your review status; identify the reviewer and basis in your notes.</p>
        <form id="desk-form">{FIELDS.map(f=><label for={'draft-'+f.id}><span>{f.label}</span><small>{f.prompt}</small><textarea id={'draft-'+f.id} name={f.id} rows={f.rows} maxlength="50000"></textarea></label>)}</form>
        <section class="apparatus"><h3>The critical apparatus</h3><p>Give each doubtful form a location, a proposed reading, and a reason. A question mark alone cannot explain your decision.</p><p id="apparatus-count" class="caption">0 / 100 apparatus entries</p><div id="apparatus-rows"></div><button id="add-entry" class="btn btn-line" type="button">Add apparatus entry +</button></section>
        <div class="draft-actions"><button id="export-markdown" class="btn btn-dark" type="button">Export Markdown ↓</button><button id="export-json" class="btn btn-line" type="button">Export portable JSON ↓</button><button id="copy-draft" class="chip" type="button">Copy draft</button><button id="copy-witness" class="chip" type="button">Copy witness link</button></div>
        <div class="import-area"><label for="import-file"><strong>Restore a portable draft</strong><small>Choose a transcription-desk JSON export (up to 1 MB). Review it before loading.</small><input id="import-file" type="file" accept=".json,application/json"/></label><div id="import-review" hidden><h3>Review imported draft</h3><p id="import-summary"></p><pre id="import-preview"></pre><div class="draft-actions"><button id="backup-import" class="chip" type="button">Export existing draft for this witness</button><button id="load-import" class="btn btn-dark" type="button">Load imported draft</button><button id="cancel-import" class="chip" type="button">Cancel</button></div></div></div>
        <p class="caption">Each witness has its own draft. Notes stay in your browser; shared witness links contain no notes. Browser data can be cleared, and exports are your backup. Keep the JSON for restoration and the Markdown for a readable report.</p>
      </div>
    </div>
    <noscript><div class="notice-box"><strong>Read all {witnesses.length} witness dossiers without JavaScript.</strong><p>The images, source records, and <a href="/transcription-desk/reading/">workshop lesson</a> remain available. Witness selection, zoom, autosave, apparatus editing, and file export require JavaScript. Write in your own document if those tools are unavailable.</p></div></noscript>
  </div></section>
  <script>
    import {mountDesk} from '../../lib/transcription-controller.js';
    mountDesk(document,window);
    document.querySelectorAll<HTMLImageElement>('.facsimile-viewport img').forEach(image=>image.setAttribute('data-facsimile',''));
  </script>
  <style>
    .desk-heading{display:flex;gap:25px;align-items:end;justify-content:space-between;margin-bottom:16px}.desk-heading label{display:grid;gap:8px;flex:1;max-width:650px}.desk-heading select{padding:14px;max-width:100%;width:100%;background:white;border:1px solid var(--line)}.desk-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:30px;margin-top:26px}.witness,.draft-column{min-width:0;border:1px solid var(--line);padding:clamp(18px,3vw,30px);background:white}.witness h2,.draft-column h2{font:500 2.2rem/1.1 var(--serif);margin:12px 0}.locator{font-size:.86rem;font-weight:650}.witness p,.apparatus p{line-height:1.7;font-size:.85rem}.zoom-tools{display:flex;gap:15px;align-items:center;flex-wrap:wrap;margin:20px 0 12px}.zoom-tools label{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:.78rem}.zoom-tools input{max-width:180px}.facsimile-viewport{max-height:640px;overflow:auto;background:var(--paper-2);border:1px solid var(--line)}.facsimile-viewport :global(img){display:block;width:100%;max-width:none;height:auto}.witness dl>div{display:grid;grid-template-columns:90px minmax(0,1fr);gap:15px;border-bottom:1px solid var(--line);padding:10px 0;font-size:.82rem}.witness dt{color:var(--muted)}.witness dd{margin:0}.witness-prompt,.source-only{padding:22px;background:var(--paper-2);margin:20px 0}.witness h3,.apparatus h3,.import-area h3{font:500 1.6rem/1.2 var(--serif)}.witness details{margin:25px 0}.witness summary{cursor:pointer;font-weight:650;font-size:.9rem}.witness blockquote{font:italic 1.5rem/1.5 var(--serif);margin:15px 0}.draft-column{background:var(--paper-2)}.draft-column form{display:grid;gap:22px}.draft-column label{display:grid;gap:7px}.draft-column label>span{font-weight:650}.draft-column small{color:var(--ink-2);font-size:.77rem;line-height:1.6}.draft-column textarea,.draft-column select{width:100%;padding:12px;background:white;border:1px solid var(--line);color:var(--ink);font:inherit;line-height:1.55}.draft-column textarea{resize:vertical}.apparatus{margin:30px 0}.apparatus :global(fieldset){border:1px solid var(--line);padding:18px;display:grid;gap:14px;margin-bottom:20px;min-width:0}.apparatus :global(legend){font-weight:650;padding:0 8px}.apparatus :global(label){display:grid;gap:7px;font-size:.82rem}.apparatus :global(textarea),.apparatus :global(select){width:100%;padding:12px;background:white;border:1px solid var(--line);font:inherit;resize:vertical}.draft-actions{display:flex;gap:10px;flex-wrap:wrap}.import-area{border-top:1px solid var(--line);padding-top:24px;margin:25px 0}.import-area input{max-width:100%;font-size:.8rem}.import-area pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:230px;overflow:auto;background:white;padding:16px;font-size:.8rem}#import-review{margin-top:22px;border:1px solid var(--line);padding:20px}#import-summary{font-size:.85rem}
    @media(max-width:850px){.desk-heading{align-items:stretch;flex-direction:column}.desk-grid{grid-template-columns:1fr}.facsimile-viewport{max-height:550px}}
  </style>
</Base>
