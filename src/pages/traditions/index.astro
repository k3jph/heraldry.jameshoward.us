---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import {getCollection} from 'astro:content';
import worldSources from '../../data/world-sources.json';
const chapters=(await getCollection('traditions')).sort((a,b)=>a.data.region.localeCompare(b.data.region));
const groups=[
  {name:'Comparative traditions',label:'Across Europe, across jurisdictions',description:'Compare how particular institutions grant, record, and preserve arms, using the sources that describe their work.'},
  {name:'Global and postcolonial heraldry',label:'Heraldry beyond Europe',description:'Where inherited artistic forms become emblems of modern states and changed sovereignties.'},
  {name:'Ecclesiastical heraldry',label:'Arms, office, and the Church',description:'Compare Catholic, Anglican, Orthodox and Lutheran uses of personal arms, office insignia, and institutional identity through dated records.'},
  {name:'Other Traditions',label:'Orders, communities, and claimed sovereignty',description:'Follow the Orders of Malta and the Teutonic Order, Jewish personal and communal armory, and micronational experiments through their particular records and institutions.'},
  {name:'Comparative emblem systems',label:'Related, not interchangeable',description:'Other sophisticated identity systems, understood in their own historical vocabularies.'}
];
const languages=[...new Set(chapters.flatMap(item=>item.data.languages))];
---
<Base title="Worldwide Heraldic Traditions" description="An expanding source-linked guide to regional, ecclesiastical and comparative heraldic traditions, with original English chapters and multilingual references.">
  <PageIntro eyebrow="Institutions, objects, and sources" title="Follow the world’s traditions." description="The English system is one tradition among many. Work through original research chapters from Europe and beyond, through Church and order traditions, and into other systems of visual identity. Follow the institutions, objects, and records that give each design its meaning." />
  <section class="section">
    <div class="wrap">
      <div class="international-intro">
        <div><p class="eyebrow"><span class="star">✦</span> The international sourcebook</p><h2>Research begins in the language of the record.</h2></div>
        <div><p>Each chapter follows a defined source or institution and supplies an original English account of what it can establish. Keep the source’s terms and dates in view as you compare systems. The linked originals remain necessary for close reading, and these teaching syntheses still await independent specialist review.</p><div style="display:flex;gap:9px;flex-wrap:wrap"><a href="/source-atlas/" class="btn btn-dark">Consult the source atlas ↗</a><a href="/seminars/" class="btn btn-line">Graduate research methods ↗</a></div></div>
      </div>
      <div class="international-metrics">
        <span><strong>{chapters.length}</strong> original research chapters</span>
        <span><strong>{worldSources.length}</strong> annotated documents and portals</span>
        <span><strong>{languages.length}</strong> chapter source languages</span>
      </div>
      {groups.map(group=><section class="international-cluster">
        <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> {group.name}</p><h2 class="section-title">{group.label}</h2></div><p>{group.description}</p></div>
        <div class="tradition-grid">
          {chapters.filter(chapter=>chapter.data.track===group.name).map((chapter)=><a class="tradition-card" href={'/traditions/'+chapter.id+'/'}><div class="tradition-card-top"><span>{chapter.data.region}</span><span aria-hidden="true">↗</span></div><h3>{chapter.data.title}</h3><p>{chapter.data.description}</p><div class="tradition-card-meta"><span>{chapter.data.languages.map(s=>s.toUpperCase()).join(' · ')}</span><span>{chapter.data.sourceIds.length} cited source{chapter.data.sourceIds.length===1?'':'s'}</span></div></a>)}
        </div>
      </section>)}
      <div class="notice-box"><strong>The scope of the collection.</strong><p>Follow national chapters alongside regional and cross-border studies. Byzantine and modern Greek material, Ukrainian and Russian histories, African grant systems, colonial encounters and religious communities require different kinds of evidence. Coverage remains uneven: regional comparisons do not replace full national histories, and many family, civic and archival traditions still need deeper investigation. These are source-linked teaching drafts awaiting specialist review. See the <a href="/editorial-policy/" style="text-decoration:underline">editorial policy</a>.</p></div>
    </div>
  </section>
</Base>
