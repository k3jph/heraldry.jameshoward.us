---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
import worldSources from '../../data/world-sources.json';
import parallelReadings from '../../data/parallel-readings.json';
import {chapterWordCount,chapterReadMinutes} from '../../lib/foundation.js';
export async function getStaticPaths(){
  const entries=await getCollection('traditions');
  return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const words=chapterWordCount(entry.body);
const minutes=chapterReadMinutes(entry.body);
const related=worldSources.filter(source=>entry.data.sourceIds.includes(source.id));
const translations=parallelReadings.filter(reading=>entry.data.sourceIds.includes(reading.sourceId));
const bibliography=related.map(source=>({name:source.titleOriginal,description:source.englishSynopsis,author:source.holding,url:source.url}));
const schema={'@context':'https://schema.org','@type':'LearningResource',name:entry.data.title,description:entry.data.description,inLanguage:'en',educationalLevel:entry.data.level,learningResourceType:'Comparative research chapter',isAccessibleForFree:true,author:{'@type':'Person',name:'James P. Howard, II'},citation:bibliography.map(b=>b.url)};
---
<Base title={entry.data.title} description={entry.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
  <section class="page-intro">
    <div class="wrap page-intro-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href="/">Home</a><span>›</span><a href="/traditions/">World traditions</a><span>›</span>{entry.data.region}</nav>
      <p class="eyebrow"><span class="star">✦</span> {entry.data.track} · {entry.data.level}</p>
      <h1 class="display-serif" style="max-width:1170px">{entry.data.title}</h1>
      <p class="page-intro-description">{entry.data.description}</p>
      <p class="caption" style="margin-top:18px">{words.toLocaleString('en-US')} words · About {minutes} minutes of reading. Allow additional time for workshops and source consultation.</p>
      <div class="international-metrics" style="margin:30px 0 0;max-width:970px"><span><strong>{entry.data.languages.join(', ')}</strong> source languages</span><span><strong>{related.length}</strong> catalogued sources</span><span><strong>{entry.data.period}</strong> historical focus</span></div>
    </div>
  </section>
  <div class="wrap world-article-shell">
    <article class="world-article">
      <p class="eyebrow"><span class="star">✦</span> A substantive research chapter</p>
      <Content/>
      <div class="notice-box" style="margin-top:48px"><strong>Academic honesty is part of the syllabus.</strong><p>These essays are original English-language syntheses with visible archival and institutional citations. They have not been independently reviewed by regional specialists. Readers should check consequential assertions against the linked source language and current law.</p></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:25px">{translations.length>0&&<a href={"/translation-lab/#translation-"+translations[0].id} class="btn btn-line">Translate a source in this chapter ↗</a>}<a href="/traditions/" class="btn btn-dark">All regional chapters ↗</a><a href="/seminars/" class="btn btn-line">Graduate seminars ↗</a></div>
    </article>
    <aside class="world-sidebar">
      <div class="world-sidebar-box"><span class="smallcaps" style="color:var(--red)">Source dossier</span><h2 class="small-title">Read the originals.</h2><p>Never let the English explanation replace the document.</p>
        {related.map(source=><a class="world-source-mini" href={'/source-atlas/#source-'+source.id}><span class="smallcaps">{source.language.toUpperCase()} · {source.authority}</span><strong>{source.titleOriginal}</strong><small>{source.holding}</small><span class="mini-arrow">Open annotated record ↗</span></a>)}
        <a class="text-link" href="/source-atlas/" style="display:inline-block;margin-top:15px">Complete primary-source atlas ↗</a>
      </div>
      <div class="world-sidebar-box world-sidebar-dark"><p class="eyebrow eyebrow-on-dark"><span class="star">✦</span> Research direction</p><h2 class="small-title">The document is not the whole truth.</h2><p>Distinguish evidence of use, an institution's legal authority, historical artist attribution, modern display and the English words used to interpret each.</p></div>
    </aside>
  </div>
</Base>
