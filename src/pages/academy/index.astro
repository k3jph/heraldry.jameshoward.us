---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import lessons from '../../data/course.json';
import { getCollection } from 'astro:content';
import { chapterReadMinutes, chapterWordCount } from '../../lib/foundation.js';
const chapters=await getCollection('foundation');
const curriculum=lessons.map(lesson=>{
  const chapter=chapters.find(item=>item.id===lesson.slug);
  if(!chapter)throw new Error('Missing foundation chapter: '+lesson.slug);
  return {...lesson,minutes:chapterReadMinutes(chapter.body)};
});
const totalMinutes=curriculum.reduce((t,l)=>t+l.minutes,0);
const totalWords=chapters.reduce((total,chapter)=>total+chapterWordCount(chapter.body),0);
const schema={'@context':'https://schema.org','@type':'Course',name:'An introduction to heraldry',description:'Independent twelve-unit heraldry course with self-assessment and practical exercises.',provider:{'@type':'Person',name:'James P. Howard, II',url:'https://jameshoward.us/'},isAccessibleForFree:true,inLanguage:'en',educationalLevel:'Introductory undergraduate / self-paced',hasCourseInstance:{'@type':'CourseInstance',courseMode:'online',courseWorkload:'Self-paced'}};
---
<Base title="The Academy" description="A twelve-unit, university-style introduction to heraldic history, tinctures, geometry, blazon, cadency, marshalling, law, and original design.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <PageIntro eyebrow="The foundation course" title="The academy." description="Twelve expanded readings, with worked examples, documentary workshops, source notes, and guided introductions. Learn to read the design and test the claims made about it."/>
  <section class="section">
    <div class="wrap">
      <div class="notice-box" style="margin-bottom:38px"><strong>Your progress belongs to you.</strong><p><span data-completion-count>0</span> of 12 units assessed successfully. Progress stays in this browser and is not sent to Analytics. Self-assessments do not confer academic credits. <a href="/privacy-and-cookie-notice/">About privacy and optional analytics</a>.</p><div class="progress-rail"><span class="progress-fill" data-course-progress></span></div></div>
      <div class="rule-heading"><div><p class="eyebrow"><span class="star">✦</span> Core curriculum</p><h2 class="section-title">Work through<br/>the evidence.</h2></div><p>{totalWords.toLocaleString('en-US')} words of chapter prose. About {totalMinutes} minutes of reading, estimated at 220 words per minute; drawing, source consultation, and research exercises take additional time. These expanded teaching drafts await specialist review.</p></div>
      <div style="margin-bottom:26px"><a class="btn btn-dark" href="/lecture/the-visual-language/">Start with guided lecture 01 ↗</a><span class="caption" style="display:inline-block;margin-left:15px;margin-top:10px">Read along, use arrow keys to move through chapters, or enable narration.</span></div><div class="module-grid">
        {curriculum.map(lesson => <a class="card module-card" href={'/academy/'+lesson.slug+'/'} data-lesson-id={lesson.slug}><div class="module-top"><span class="module-number">{String(lesson.number).padStart(2,'0')}</span><span class="module-duration">About {lesson.minutes} min reading <span class="progress-dot" title="Assessment status"></span></span></div><h3>{lesson.title}</h3><p>{lesson.description}</p><div class="module-foot"><span>{lesson.eyebrow}</span><span>Study ↗</span></div></a>)}
      </div>
    </div>
  </section>
  <section class="section section-toned" style="padding:65px 0">
    <div class="wrap split" style="align-items:center"><div><p class="eyebrow"><span class="star">✦</span> Continue beyond the foundation</p><h2 class="section-title">Follow the regional sources.</h2></div><div><p class="section-subtitle">The foundation gives you a working vocabulary and a method for testing a claim. The regional chapters apply those tools to particular institutions and records; the research seminars develop transcription, comparison, and source criticism into larger investigations.</p><div class="continuation-actions"><a class="btn btn-dark" href="/traditions/">Study world traditions ↗</a><a class="btn btn-line" href="/seminars/">Graduate seminar ↗</a><a href="/translation-lab/" class="btn btn-line">Read original languages ↗</a></div></div></div>
  </section>
  <section class="section section-dark">
    <div class="wrap split" style="align-items:center">
      <div><p class="eyebrow eyebrow-on-dark"><span class="star">✦</span> The capstone</p><h2 class="section-title">Explain what<br/>the evidence supports.</h2><p class="section-subtitle" style="margin-top:22px">Study a documented display or develop an original teaching design. Build a witness inventory, test competing explanations, and show how your conclusion follows from the evidence. Extended routes develop material histories, institutional comparisons, critical editions, and controlled design studies.</p></div>
      <div><p style="font:italic 2rem/1.35 var(--serif);color:var(--gold-light)">A blazon explains how to draw the design. A claim to bear it needs a connection between that design, the person, and the relevant record. Your study should show how you established each step.</p><a class="btn btn-gold" href="/academy/reading-the-evidence/">Explore the capstone ↗</a></div>
    </div>
  </section>
  <script>
    const saved = (()=>{try{return JSON.parse(localStorage.getItem('heraldry-completed-v1') || '[]');}catch{return [];}})();
    const completed = Array.isArray(saved) ? saved : [];
    document.querySelectorAll<HTMLElement>('[data-lesson-id]').forEach(el => {if(completed.includes(el.dataset.lessonId)){el.classList.add('is-complete');el.setAttribute('aria-label',el.textContent?.trim()+' — completed');}});
    const count = document.querySelector<HTMLElement>('[data-completion-count]');
    const rail = document.querySelector<HTMLElement>('[data-course-progress]');
    if(count) count.textContent=String(completed.length);
    if(rail) rail.style.width=(Math.min(completed.length,12)/12*100)+'%';
  </script>
</Base>


<style>
  .continuation-actions{display:flex;flex-wrap:wrap;gap:9px;align-items:stretch}
  .continuation-actions .btn{max-width:100%}
</style>
