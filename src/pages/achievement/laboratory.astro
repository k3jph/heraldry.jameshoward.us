---
import Base from '../../layouts/Base.astro';
---
<Base title="Anatomy Laboratory — Beyond the Shield" description="Interactively show and hide heraldic crests, helmets, mantling, supporters, compartments, mottos and insignia, then compare regional meanings.">
  <section class="page-intro">
    <div class="wrap page-intro-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href="/">Home</a><span>›</span><a href="/achievement/">Beyond the shield</a><span>›</span>Anatomy laboratory</nav>
      <p class="eyebrow"><span class="star">✦</span> A comparative anatomy laboratory</p>
      <h1 class="display-serif">The whole<br/>achievement.</h1>
      <p class="page-intro-description">What happens to an achievement when you remove its crest, supporters, or motto? Change the rendering, then change the region. The visible components stay the same, but the questions we ask about them do not.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap achievement-lab">
      <div class="lab-panel">
        <div class="lab-heading"><div><p class="eyebrow"><span class="star">✦</span> Constructed teaching plate</p><h2>One invented arrangement.</h2></div><span class="smallcaps">Not a grant · Not a historical achievement</span></div>
        <div class="lab-plate">
          <svg viewBox="0 0 420 480" role="img" aria-labelledby="plate-title plate-description" xmlns="http://www.w3.org/2000/svg">
            <title id="plate-title">Schematic heraldic achievement with independently removable parts</title>
            <desc id="plate-description">An invented blue and gold shield with three stars, helmet, gold and blue mantling, paired horns as a crest, two symbolic supporters, compartment, motto scroll, and optional chain of an order.</desc>
            <g data-layer-image="supporters" fill="#e5d6b3" stroke="#493342" stroke-width="3" stroke-linejoin="round">
              <g transform="translate(72 265)">
                <path d="M9 28 C-15 -7 -13 -42 14 -61 C30 -73 48 -68 58 -53 L44 -44 C41 -52 33 -53 26 -46 C10 -32 21 -7 39 2 L51 42 L36 89 L23 86 L27 42 Z"/>
                <path d="M14 -58 L-3 -67 L2 -43 M34 -52 L42 -73 L51 -45 M25 83 L0 91 L30 91 M47 89 L66 96 L35 99" />
                <path d="M12 26 C-21 42 -32 21 -26 0 C-12 15 -4 12 1 4" fill="none"/>
                <circle cx="29" cy="-34" r="3" fill="#493342" stroke="none"/>
              </g>
              <g transform="translate(348 265) scale(-1 1)">
                <path d="M9 28 C-15 -7 -13 -42 14 -61 C30 -73 48 -68 58 -53 L44 -44 C41 -52 33 -53 26 -46 C10 -32 21 -7 39 2 L51 42 L36 89 L23 86 L27 42 Z"/>
                <path d="M14 -58 L-3 -67 L2 -43 M34 -52 L42 -73 L51 -45 M25 83 L0 91 L30 91 M47 89 L66 96 L35 99" />
                <path d="M12 26 C-21 42 -32 21 -26 0 C-12 15 -4 12 1 4" fill="none"/>
                <circle cx="29" cy="-34" r="3" fill="#493342" stroke="none"/>
              </g>
            </g>
            <g data-layer-image="compartment">
              <path d="M28 374 Q75 354 122 366 Q211 344 297 366 Q346 351 393 374 L382 395 Q202 407 39 395 Z" fill="#c0a86e" stroke="#493342" stroke-width="3"/>
              <path d="M42 376 Q200 390 378 376" fill="none" stroke="#faedc9" stroke-width="3"/>
            </g>
            <g data-layer-image="mantling" stroke="#493342" stroke-width="2.5">
              <path d="M180 140 Q153 126 130 145 Q112 164 80 154 Q102 183 125 178 Q80 209 101 240 Q102 222 139 211 Q107 249 134 268 Q129 232 176 190 Z" fill="#b78e4b"/>
              <path d="M240 140 Q267 126 290 145 Q308 164 340 154 Q318 183 295 178 Q340 209 319 240 Q318 222 281 211 Q313 249 286 268 Q291 232 244 190 Z" fill="#b78e4b"/>
              <path d="M180 155 Q135 160 129 170 Q156 176 164 171 Q118 211 142 221 Q145 202 181 186 Z" fill="#f9efcc"/>
              <path d="M240 155 Q285 160 291 170 Q264 176 256 171 Q302 211 278 221 Q275 202 239 186 Z" fill="#f9efcc"/>
            </g>
            <g data-layer-image="helmet" stroke="#493342" stroke-width="3" stroke-linejoin="round">
              <path d="M181 121 Q179 96 198 86 Q220 78 238 98 L243 133 Q230 151 211 155 L180 140 Z" fill="#cbd3d3"/>
              <path d="M182 121 L242 121 L239 136 L180 137 Z" fill="#8c9b9e"/>
              <path d="M194 101 L234 101 M193 110 L240 110 M203 102 L205 137 M218 102 L219 138" fill="none"/>
              <path d="M185 138 Q209 151 239 138" fill="none"/>
            </g>
            <g data-layer-image="crest" stroke="#493342" stroke-width="3" stroke-linejoin="round">
              <path d="M188 91 C162 58 172 22 185 12 C178 45 206 52 209 79 Z" fill="#e1af54"/>
              <path d="M232 91 C258 58 248 22 235 12 C242 45 214 52 211 79 Z" fill="#e1af54"/>
              <path d="M176 52 L199 65 M245 52 L222 65" stroke="#315b87" stroke-width="10"/>
              <path d="M171 94 C187 81 198 98 209 90 C222 82 231 99 248 94 L240 109 C228 102 215 111 207 106 C196 101 190 104 181 111 Z" fill="#315b87"/>
              <path d="M179 98 L188 105 M196 93 L204 107 M215 92 L223 106 M234 95 L241 103" stroke="#f2d29b" stroke-width="5"/>
            </g>
            <g stroke="#493342" stroke-width="4" stroke-linejoin="round">
              <path d="M210 160 L290 192 L281 315 Q256 355 210 371 Q164 355 139 315 L130 192 Z" fill="#f4e9c7"/>
              <path d="M210 160 L290 192 L210 262 L130 192 Z" fill="#315b87" stroke="none"/>
              <path d="M210 262 L281 315 Q256 355 210 371 Q164 355 139 315 Z" fill="#315b87" stroke="none"/>
              <path d="M139 227 L274 178 L282 204 L146 254 Z" fill="#d6a244" stroke="none"/>
              <path d="M210 160 L290 192 L281 315 Q256 355 210 371 Q164 355 139 315 L130 192 Z" fill="none"/>
            </g>
            <g fill="#f4e9c7" stroke="#493342" stroke-width="2">
              <path d="M205 204 L210 190 L215 204 L230 204 L218 213 L223 229 L210 219 L197 229 L202 213 L190 204 Z"/>
              <path d="M174 285 L179 272 L184 285 L199 285 L187 294 L192 309 L179 299 L166 309 L171 294 L159 285 Z"/>
              <path d="M236 285 L241 272 L246 285 L261 285 L249 294 L254 309 L241 299 L228 309 L233 294 L221 285 Z"/>
            </g>
            <g data-layer-image="orders" fill="none" stroke="#493342" stroke-width="2.5">
              <path d="M115 226 Q112 330 210 401 Q310 330 306 226" stroke="#c49b4b" stroke-width="10" stroke-dasharray="12 5"/>
              <path d="M115 226 Q112 330 210 401 Q310 330 306 226" stroke="#493342" stroke-width="1.5" stroke-dasharray="12 5"/>
              <path d="M210 396 L220 416 L242 417 L225 432 L232 453 L210 440 L188 453 L195 432 L178 417 L200 416 Z" fill="#d6a244"/>
              <circle cx="210" cy="426" r="8" fill="#315b87"/>
            </g>
            <g data-layer-image="motto" stroke="#493342" stroke-width="2">
              <path d="M72 423 Q210 447 348 423 L355 454 Q213 480 64 454 Z" fill="#f5e6c2"/>
              <path d="M72 423 L59 417 L66 443 L64 454 M348 423 L361 417 L354 443 L355 454" fill="#ddc596"/>
              <text x="210" y="450" text-anchor="middle" fill="#493342" stroke="none" font-family="Georgia,serif" font-size="15" letter-spacing="2">EXEMPLUM</text>
            </g>
          </svg>
        </div>
        <p class="lab-caption">The fictional plate illustrates relationships between components. Hiding a layer changes the <em>depiction</em>; it does not revoke, grant, or establish a heraldic right. The crest uses stylized paired horns as a teaching allusion, not as an attribution to an actual family.</p>
      </div>
      <aside class="lab-controls">
        <div class="lab-control-card">
          <p class="eyebrow"><span class="star">✦</span> Visible components</p>
          <h2>Choose the layers.</h2>
          <fieldset class="lab-fieldset" id="layer-controls"><legend>Elements in the schematic achievement</legend>
            <label><input type="checkbox" data-layer="crest" checked/>Crest and wreath<span>Physical origin: upper ornament</span></label>
            <label><input type="checkbox" data-layer="helmet" checked/>Helmet<span>Armorial presentation</span></label>
            <label><input type="checkbox" data-layer="mantling" checked/>Mantling<span>Cloth and artistic treatment</span></label>
            <label><input type="checkbox" data-layer="supporters" checked/>Supporter-like figures<span>Status cannot be read from the drawing</span></label>
            <label><input type="checkbox" data-layer="compartment" checked/>Compartment<span>Ground beneath the figures</span></label>
            <label><input type="checkbox" data-layer="motto" checked/>Motto scroll<span>Language and identity</span></label>
            <label><input type="checkbox" data-layer="orders"/>Order insignia<span>May depend on honours or office</span></label>
          </fieldset>
          <button type="button" class="btn btn-line" id="reset-achievement">Restore teaching example ↺</button>
          <p class="caption" role="status" aria-live="polite" id="layer-summary">Six external components shown; the shield is always visible.</p>
        </div>
        <div class="lab-control-card lab-lens-card">
          <p class="eyebrow"><span class="star">✦</span> Regional interpretation</p>
          <h2>Change the questions.</h2>
          <label class="lab-lens-label" for="jurisdiction-lens">Tradition to examine</label>
          <select id="jurisdiction-lens">
            <option value="scotland">Scotland</option>
            <option value="england">England and Wales</option>
            <option value="germany">German-speaking Europe</option>
            <option value="iberia">Iberian traditions</option>
            <option value="canada">Canada</option>
          </select>
          <div id="lens-results" aria-live="polite" aria-atomic="true">
            <h3 id="lens-title">Scotland: person and allegiance</h3>
            <p id="lens-description">A personal crest in a recorded achievement and a clan member's use of the chief's crest in a strap-and-buckle badge represent different relationships. Supporters require their own Scottish entitlement analysis.</p>
            <a href="/traditions/scotland/" class="text-link" id="lens-link">Read the regional chapter ↗</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
  <section class="section section-toned">
    <div class="wrap split">
      <div><p class="eyebrow"><span class="star">✦</span> Interpretation is a research act</p><h2 class="section-title">A depicted lion is<br/>not yet a privilege.</h2></div>
      <div><p>Ask four questions of every component you see: What is visibly present? Which documentary source names it? What date and jurisdiction govern the source? Does the document describe an ornament, a bearing, a grant, or an inherited right?</p><p>Explore the <a href="/achievement/">eight achievement readings</a> before treating a modern convention as medieval evidence.</p><a class="btn btn-dark" href="/achievement/">Read the achievement course ↗</a></div>
    </div>
  </section>
</Base>
<script>
const lenses={
  scotland:{title:'Scotland: person and allegiance',description:"A personal crest in a recorded achievement and a clan member's use of the chief's crest in a strap-and-buckle badge represent different relationships. Supporters require their own Scottish entitlement analysis.",link:'/traditions/scotland/'},
  england:{title:'England: the grant and its extensions',description:'Arms and crests may appear in grants; supporters and badges require attention to the eligible bearer and any separately granted rights. Merely adding a pair of figures does not create supporters.',link:'/traditions/england/'},
  germany:{title:'Germanic practice: a coordinated upper achievement',description:'Helmet, Helmzier and Helmdecken may form a connected Oberwappen. Repeated shield motifs are a valued compositional practice in some traditions; decorative shield-holders cannot automatically be equated with English granted supporters.',link:'/traditions/germany/'},
  iberia:{title:'Iberia: shield, timbre and important exceptions',description:"Ordinary representations frequently emphasize the shield and crowns, but the winged-dragon royal cimera of Aragon demonstrates an important crest tradition. Local period and regional vocabulary matter.",link:'/traditions/spain/'},
  canada:{title:'Canada: explicit components and eligibility',description:"Canadian grants may describe arms, crests, mottos, badges and flags. Supporters are available under defined modern categories, including certain institutions, officeholders and recipients of major honours.",link:'/traditions/canada/'}
};
const toggles=Array.from(document.querySelectorAll<HTMLInputElement>('#layer-controls input[data-layer]'));
const output=document.querySelector<HTMLElement>('#layer-summary');
const updateLayers=()=>{
  let visible=0;
  toggles.forEach(input=>{
    const layer=input.dataset.layer;
    const group=layer&&document.querySelector<SVGGElement>('[data-layer-image="'+layer+'"]');
    if(group){group.style.display=input.checked?'':'none';if(input.checked)visible++;}
  });
  if(output)output.textContent=visible+' of '+toggles.length+' optional layers are depicted. The shield is always visible. Visibility is not entitlement.';
};
toggles.forEach(input=>input.addEventListener('change',updateLayers));
document.querySelector<HTMLButtonElement>('#reset-achievement')?.addEventListener('click',()=>{
  toggles.forEach(input=>{input.checked=input.dataset.layer!=='orders';});
  updateLayers();
});
const select=document.querySelector<HTMLSelectElement>('#jurisdiction-lens');
const updateLens=()=>{
  const key=select?.value as keyof typeof lenses;
  const lens=lenses[key]||lenses.scotland;
  const title=document.querySelector<HTMLElement>('#lens-title');
  const description=document.querySelector<HTMLElement>('#lens-description');
  const link=document.querySelector<HTMLAnchorElement>('#lens-link');
  if(title)title.textContent=lens.title;
  if(description)description.textContent=lens.description;
  if(link)link.href=lens.link;
};
select?.addEventListener('change',updateLens);
updateLayers();
updateLens();
</script>
<style>
.achievement-lab{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(290px,.8fr);gap:24px;align-items:start}
.lab-panel{background:var(--white);border:1px solid var(--line);padding:24px;min-width:0}
.lab-heading{display:flex;justify-content:space-between;align-items:start;gap:22px}
.lab-heading h2,.lab-controls h2{font:500 2rem/1.1 var(--serif);margin:0 0 14px}
.lab-heading .smallcaps{color:var(--muted);max-width:160px;text-align:right}
.lab-plate{background:radial-gradient(circle at center,#f9f1e1 0%,#ecdec6 95%);border:1px solid var(--line);margin:10px 0 16px;min-height:360px;display:grid;place-items:center}
.lab-plate svg{width:min(100%,470px);height:auto;max-height:610px}
.lab-caption{font-size:.87rem;color:var(--ink-2);margin:0}
.lab-controls{display:grid;gap:20px}
.lab-control-card{padding:25px;background:var(--white);border:1px solid var(--line)}
.lab-fieldset{margin:10px 0 22px;padding:0;border:0;display:grid;gap:8px}
.lab-fieldset legend{font-weight:700;font-size:.85rem;margin-bottom:10px}
.lab-fieldset label{display:grid;grid-template-columns:24px 1fr;gap:0 10px;cursor:pointer;padding:12px;background:var(--paper);border:1px solid var(--line);font-weight:700;line-height:1.3}
.lab-fieldset label input{grid-row:1/3;accent-color:var(--red);width:17px;height:17px;margin:2px 0 0}
.lab-fieldset label span{grid-column:2;color:var(--muted);font-size:.73rem;font-weight:400;margin-top:3px}
.lab-control-card .btn{white-space:normal}
.lab-control-card .caption{margin:18px 0 0}
.lab-lens-label{display:block;font-weight:700;font-size:.78rem;margin:12px 0 8px}
#jurisdiction-lens{width:100%;padding:12px 14px;background:var(--paper);border:1px solid var(--line);color:var(--ink)}
#lens-results{margin-top:18px;padding:18px;background:var(--paper);border-left:3px solid var(--gold)}
#lens-results h3{font:500 1.5rem/1.2 var(--serif);margin:0 0 10px}
#lens-results p{margin:0 0 20px}
@media(max-width:950px){.achievement-lab{grid-template-columns:1fr}.lab-controls{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.lab-controls{grid-template-columns:1fr}.lab-panel,.lab-control-card{padding:17px}.lab-heading{display:block}.lab-heading .smallcaps{display:block;text-align:left;max-width:none;margin:0 0 12px}}
</style>