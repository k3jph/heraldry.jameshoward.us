{
  "name": "the-heraldry-project",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/reset-astro-cache.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "dev:reset": "node scripts/reset-astro-cache.mjs && astro sync",
    "start": "npm run dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.3"
  }
}
